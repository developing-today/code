{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://developing-today.github.io/code/schemas/transport-adapters-v1.json",
  "title": "Transport adapter registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "adapters"],
  "properties": {
    "schema_version": { "const": 1 },
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/adapter" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "level": {
      "enum": ["none", "read", "bidirectional", "write-capable", "sync-equivalent"]
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "shape",
        "addressing",
        "levels",
        "delivery",
        "identity_binding",
        "capability_gating",
        "metering"
      ],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "version": { "type": "integer", "minimum": 1 },
        "shape": { "enum": ["transport", "proxy"] },
        "addressing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["carrier_address", "identity_mapping"],
          "properties": {
            "carrier_address": { "type": "string", "minLength": 1 },
            "identity_mapping": { "type": "string", "minLength": 1 }
          }
        },
        "levels": {
          "type": "object",
          "additionalProperties": false,
          "required": ["send", "receive"],
          "properties": { "send": { "$ref": "#/$defs/level" }, "receive": { "$ref": "#/$defs/level" } }
        },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["guarantee", "ordering", "causal_metadata", "latency", "size_limit", "offline_behavior"],
          "properties": {
            "guarantee": { "enum": ["at-most-once", "at-least-once", "best-effort", "not-applicable"] },
            "ordering": { "type": "string", "minLength": 1 },
            "causal_metadata": { "type": "string", "minLength": 1 },
            "latency": { "type": "string", "minLength": 1 },
            "size_limit": { "type": "string", "minLength": 1 },
            "offline_behavior": { "type": "string", "minLength": 1 }
          }
        },
        "identity_binding": { "enum": ["cryptographic", "mapped", "none"] },
        "capability_gating": {
          "type": "object",
          "additionalProperties": false,
          "required": ["send", "receive", "revocation"],
          "properties": {
            "send": { "type": "string", "minLength": 1 },
            "receive": { "type": "string", "minLength": 1 },
            "revocation": { "type": "string", "minLength": 1 }
          }
        },
        "metering": {
          "type": "object",
          "additionalProperties": false,
          "required": ["counted", "counter_location"],
          "properties": {
            "counted": { "type": "array", "items": { "enum": ["messages", "bytes", "actions"] }, "uniqueItems": true },
            "counter_location": { "type": "string", "minLength": 1 }
          }
        },
        "custody": {
          "type": "object",
          "additionalProperties": false,
          "required": ["credential_holder", "translation_boundary", "trust_statement", "authority_ceiling"],
          "properties": {
            "credential_holder": { "type": "string", "minLength": 1 },
            "translation_boundary": { "type": "string", "minLength": 1 },
            "trust_statement": { "type": "string", "minLength": 1 },
            "authority_ceiling": { "type": "string", "minLength": 1 }
          }
        },
        "evidence": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "shape": { "const": "proxy" } }, "required": ["shape"] },
          "then": { "required": ["custody"] },
          "else": { "not": { "required": ["custody"] } }
        },
        {
          "if": {
            "properties": {
              "levels": { "properties": { "send": { "const": "write-capable" } }, "required": ["send"] }
            },
            "required": ["levels"]
          },
          "then": { "properties": { "capability_gating": { "properties": { "send": { "minLength": 1 } } } } }
        }
      ]
    }
  }
}
