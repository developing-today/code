[Unit]
Description=Fleet conductor silence heartbeat probe (#15123)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Reads only the conductor's own cycle log: the 2026-11-24 silence
# happened because no schedule existed for the conductor at all, so
# scheduler state is never evidence of conductor health.
#
# Observe-only until ~/.config/conductor-silence/mode reads "apply";
# then it files/comments on GitHub with the gh login of this user.
ExecStart=/usr/bin/env bash -c ' \
  flag=""; \
  if [ "$(cat "$HOME/.config/conductor-silence/mode" 2>/dev/null)" = "apply" ]; then \
    flag="--apply"; \
  fi; \
  exec /usr/bin/env python3 %h/git/code/scripts/fleet/conductor-silence/check_conductor.py \
    --log-file %h/workspace/goals/keep-the-four-repos-healthy/hidden_files/conductor-log.md $flag'
WorkingDirectory=%h/git/code
