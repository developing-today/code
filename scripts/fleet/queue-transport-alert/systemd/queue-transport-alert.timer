[Unit]
Description=Repo-queue broker transport alert probe, every 10 minutes (#6369)

[Timer]
# Two consecutive failed probes alert, so an outage surfaces within
# about 20 minutes, inside the issue's ~15-minute target plus one tick.
OnBootSec=5m
OnUnitActiveSec=10m
RandomizedDelaySec=30s

[Install]
WantedBy=timers.target
