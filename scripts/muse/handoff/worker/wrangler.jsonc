{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "muse-agent-handoff",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-11-21",
  "workers_dev": true,
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [{ "name": "HANDOFFS", "class_name": "Handoff" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Handoff"] }
  ]
}
