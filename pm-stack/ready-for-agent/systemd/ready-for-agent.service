# ready-for-agent — systemd USER unit (pm-stack Phase 2, dispatch layer).
#
# ready-for-agent (github.com/berenddeboer/ready-for-agent, MIT) is
# distributed as an npm package that boots a compiled binary — there
# is no upstream container image — so it runs as a user service in
# the same declarative style as pm-tunnel. It requires a systemd
# user manager with cgroup v2 delegation (systemd >= 254; this host
# has 261) and refuses local execution anywhere else.
#
# Install (on the host, from the pm-stack deployment directory):
#   pm-stack/ready-for-agent/install.sh
# which places this unit at ~/.config/systemd/user/ready-for-agent.service
# and enables it. State (SQLite) lives in
# ~/.local/share/ready-for-agent/ by upstream default.
#
# The UI + GraphQL listen on port 6056. Since 2026-10-25 the unit
# binds all interfaces (bare --host): loopback + tailnet + LAN —
# Drew's call (LAN/tailnet access fine; a public endpoint only
# behind a password). No public route is configured.
#
# PATH is explicit: the harness shells out to git, gh, and the
# fleet's OpenCode 2 (`opencode` from the per-user profile — v1 is
# rejected by the harness), and its own binary lives in ~/.local/bin
# (install.sh installs the pinned npm package there, the system npm
# prefix being the read-only Nix store).
[Unit]
Description=ready-for-agent — label-driven issue dispatch (pm-stack)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/pm-stack/ready-for-agent
Environment=PATH=%h/.local/bin:/etc/profiles/per-user/user/bin:%h/.nix-profile/bin:/run/current-system/sw/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/ready-for-agent start --no-open --host
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
