[Unit]
Description=PM console — keep its named tunnel ingress pointed at the local console (pm-stack)
Documentation=https://github.com/developing-today/code/tree/main/pm-stack/console
After=network-online.target

[Service]
Type=oneshot
# Keeps only the laptop's named tunnel ingress pointed at its console.
# Access, DNS and Worker configuration are applied from repository Actions.
ExecStart=/etc/profiles/per-user/%u/bin/python3 %h/.local/share/pm-console/current/pm-stack/console/scripts/expose.py
Environment=PATH=%h/.local/bin:/run/current-system/sw/bin:/etc/profiles/per-user/%u/bin:/usr/bin:/bin
TimeoutStartSec=600
