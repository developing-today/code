[Unit]
Description=PM console — look every ten minutes for an Android build to sign and release (pm-stack)

[Timer]
# Soon after it is first installed, soon after a boot, then every ten minutes.
OnActiveSec=2min
OnBootSec=6min
OnUnitActiveSec=10min
RandomizedDelaySec=30

[Install]
WantedBy=timers.target
