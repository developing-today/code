[Unit]
Description=PM console — sign the newest Android build GitHub made, here, and release it (pm-stack)
Documentation=https://github.com/developing-today/code/tree/main/pm-stack/console/android
After=network-online.target

[Service]
Type=oneshot
# Asks GitHub one question and does nothing, unless GitHub has built a
# version of the app that is not released yet. Then the build is signed
# on this machine, which holds the key, and released. The key is read
# by apksigner here and goes nowhere.
ExecStart=/run/current-system/sw/bin/bash %h/git/code/pm-stack/console/android/release-built.sh
Environment=PATH=%h/.local/bin:/etc/profiles/per-user/%u/bin:/run/current-system/sw/bin:/usr/bin:/bin
# The first run may have to fetch apksigner.
TimeoutStartSec=900
