[Unit]
Description=PM console — put merged console code into service, if it starts (pm-stack)
Documentation=https://github.com/developing-today/code/tree/main/pm-stack/console
After=network-online.target

[Service]
Type=oneshot
# Asks GitHub for main, and does nothing more unless the console's code
# there is not the code in service. New code is laid out as a release
# of its own and started in a self-check first; code that does not
# start, or does not come up in service, never stays in service.
ExecStart=/run/current-system/sw/bin/bash %h/.local/share/pm-console/current/pm-stack/console/redeploy.sh
Environment=PATH=%h/.local/bin:/etc/profiles/per-user/%u/bin:/run/current-system/sw/bin:/usr/bin:/bin
TimeoutStartSec=300
