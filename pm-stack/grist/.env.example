# Template for the Grist .env — DO NOT put real values in this file.
#
# deploy.sh renders the real .env (mode 600, never committed) from
# ../../secrets/pm-stack.sops.yaml. This template exists so the shape
# of the configuration is reviewable in git. Key names match the
# SOPS file; deploy.sh performs the mapping noted beside each entry.

# --- Sessions ---
# SOPS: grist_session_secret  (openssl rand -hex 32; signs session
# cookies. Changing it signs everyone out; keep it stable.)
GRIST_SESSION_SECRET=
