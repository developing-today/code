# Template for the pm-stack .env — DO NOT put real values in this file.
#
# deploy.sh renders the real .env (mode 600, never committed) from
# ../secrets/pm-stack.sops.yaml. This template exists so the shape of the
# configuration is reviewable in git. Key names match the SOPS file;
# deploy.sh performs the mapping noted beside each group.

# --- Public identity of the instance ---
# SOPS: (fixed, not secret) — set in deploy.sh
KANEO_CLIENT_URL=https://kaneo.security.cab

# --- PostgreSQL (compose service "postgres") ---
POSTGRES_DB=kaneo
POSTGRES_USER=kaneo
# SOPS: postgres_password
POSTGRES_PASSWORD=

# --- Kaneo authentication ---
# SOPS: auth_secret  (openssl rand -hex 32; keep stable — changing it
# signs everyone out)
AUTH_SECRET=
# SOPS: notification_secret_encryption_key  (openssl rand -hex 32; keep
# stable — protects saved notification tokens and signing secrets)
NOTIFICATION_SECRET_ENCRYPTION_KEY=
# Registration is CLOSED by default and deploy.sh renders it that
# way. To bootstrap the very first account, render once with
# KANEO_OPEN_REGISTRATION=1 ./deploy.sh, create the account, then
# re-run ./deploy.sh (no variable) to close registration again. See
# README.md, "First account + lock down registration".
DISABLE_REGISTRATION=true

# --- GitHub integration (our own GitHub App; see README.md) ---
# SOPS: github_app_id
GITHUB_APP_ID=
# SOPS: github_app_name  (the app's slug)
GITHUB_APP_NAME=
# SOPS: github_webhook_secret
GITHUB_WEBHOOK_SECRET=
# SOPS: github_private_key_base64  (base64 of the app private key PEM;
# Kaneo prefers this over a raw PEM in GITHUB_PRIVATE_KEY)
GITHUB_PRIVATE_KEY_BASE64=
