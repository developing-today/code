<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app's icon: the things done most, one tap away. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_mic"
        android:shortcutId="dictate"
        android:shortcutLongLabel="@string/sc_dictate_long"
        android:shortcutShortLabel="@string/sc_dictate">
        <intent
            android:action="today.developing.pmconsole.DICTATE"
            android:targetClass="today.developing.pmconsole.DictateActivity"
            android:targetPackage="today.developing.pmconsole" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_ask"
        android:shortcutId="ask"
        android:shortcutLongLabel="@string/sc_ask_long"
        android:shortcutShortLabel="@string/sc_ask">
        <intent
            android:action="today.developing.pmconsole.OPEN_ASK"
            android:targetClass="today.developing.pmconsole.OpenActivity"
            android:targetPackage="today.developing.pmconsole" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_needs"
        android:shortcutId="needs"
        android:shortcutLongLabel="@string/sc_needs_long"
        android:shortcutShortLabel="@string/sc_needs">
        <intent
            android:action="today.developing.pmconsole.OPEN_NEEDS"
            android:targetClass="today.developing.pmconsole.OpenActivity"
            android:targetPackage="today.developing.pmconsole" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_now"
        android:shortcutId="now"
        android:shortcutLongLabel="@string/sc_now_long"
        android:shortcutShortLabel="@string/sc_now">
        <intent
            android:action="today.developing.pmconsole.OPEN_NOW"
            android:targetClass="today.developing.pmconsole.OpenActivity"
            android:targetPackage="today.developing.pmconsole" />
    </shortcut>
</shortcuts>
