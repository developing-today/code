{
  // The empty Worker release.mjs stands up when there is none: see
  // worker.ts. Everything here that is not a version's own (the name,
  // the Durable Object class and its migration, the workers.dev
  // address, logs) must say what ../wrangler.jsonc says; a test holds
  // the two together (test/release.test.ts).
  "name": "pm-console-edge",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": { "PUBLIC_HOST": "pm.security.cab", "VERSION": "empty" },
  "durable_objects": { "bindings": [{ "name": "PM", "class_name": "PmEdge" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PmEdge"] }]
}
