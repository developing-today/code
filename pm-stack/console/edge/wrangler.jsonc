{
  // The Worker in front of pm.security.cab: the app, its state,
  // notifications and the phone widget, served from Cloudflare.
  //
  // Deployed by the pm-console-edge-deploy workflow (release.mjs: an
  // empty Worker from init/ if there is none, then this as a version).
  // It has no route here on purpose: scripts/expose.py on the host puts
  // the hostname's route on it once it answers its health check, and can
  // take the route away again, which is the whole rollback.
  "name": "pm-console-edge",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // The workers.dev address answers the health check and the public
  // files only: every other path needs the owner's sign-in token, which
  // is only issued for the routed hostname.
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": { "PUBLIC_HOST": "pm.security.cab" },
  // The app's files, put together by build.mjs. Every request reaches
  // the Worker first; it serves a file only after checking who asks.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  // The message bridge, called by service binding (#14373): the edge
  // sends the owner's messages through it with the PM stack's own
  // bridge credential, and reads the agents list and the message log
  // from it, instead of waiting for a machine's fleet binary.
  "services": [{ "binding": "BRIDGE", "service": "message-bridge" }],
  // One object holds the state: the copy of what the host last
  // reported, what is held for it, notification subscriptions and keys,
  // linked phones. Three secrets are optional, put there by
  // scripts/expose.py --edge-direct (off by default): GITHUB_TOKEN and
  // QUEUE_TOKEN, which let the Worker read and write GitHub and the
  // queue store itself while the laptop is away, and EDGE_DIRECT, the
  // explicit opt-in that must read `on` for either to be used. A fourth,
  // BRIDGE_TOKEN, is the PM bridge credential the binding above is
  // called with; expose.py uploads it in the same pass when the vault
  // holds it, and without it the bridge verbs stay a machine's.
  "durable_objects": { "bindings": [{ "name": "PM", "class_name": "PmEdge" }] },
  // The fleet-platform ledger's D1 home (#14968, owner ruling
  // 2026-11-26 on #14866): the hosted ledger surfaces read it when
  // LEDGER_PAGES reads `on` and LEDGER_STORE reads `d1`. The database
  // holds the ledger tables under their SQLite names, schema-identical
  // to the fleet-platform Turso they were copied from; the Turso read
  // path remains beside it as the rollback.
  "d1_databases": [
    { "binding": "LEDGER_DB", "database_name": "fleet-platform", "database_id": "57d15925-b0b8-4466-a92c-c200a6af4c45" }
  ],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PmEdge"] }]
}
