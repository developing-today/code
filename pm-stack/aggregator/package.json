{
  "name": "pm-aggregator-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The PM-stack aggregator UI: cross-repo WIP board, roadmap timeline, quota + throughput, and needs-you views. Read-mostly projection over the projector/link registry, Kaneo, Pad, and Grist.",
  "scripts": {
    "dev": "PM_AGG_DEV=1 bun run src/server.ts",
    "start": "bun run src/server.ts",
    "test": "bun test",
    "report:generate": "bun run scripts/generate-report.ts",
    "backtest:quota-forecast": "bun run scripts/quota-forecast-backtest.ts",
    "measure:daytype-sufficiency": "bun run scripts/quota-daytype-sufficiency.ts",
    "replay:quota-anomaly": "bun run scripts/quota-anomaly-replay.ts",
    "contract:check": "bun run scripts/check-contract-corpus.ts",
    "provenance:check": "bun run scripts/check-provenance-matrix.ts",
    "typecheck": "bunx tsc --noEmit",
    "build:css": "tailwindcss -i src/ui.css -o src/assets/app.css",
    "proposals:quota-reweight": "bun run scripts/quota-reweight-proposals.ts",
    "review:quota-weekly": "bun run scripts/quota-weekly-review.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/cli": "^4.3.4",
    "@types/bun": "latest",
    "daisyui": "^5.7.50",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "web-push": "^3.6.7"
  }
}
