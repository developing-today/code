[Unit]
Description=Quota gatherer — provider quotas every ~15 minutes (pm-stack, #1151)
After=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=300
WorkingDirectory=%h/git/code/pm-stack/aggregator
# The gatherer runs from the laptop's code checkout; all outputs are
# pinned to the stable state directory below, never the checkout.
# The gatherer imports the OpenChamber quota module from the laptop
# checkout, reads OpenCode's credential store directly, and ingests
# laptop file exports (Meta, #1301).
Environment=QUOTA_CURRENT_PATH=%h/.local/state/pm-aggregator/quota-current.json
Environment=QUOTA_HEARTBEAT_PATH=%h/.local/state/pm-aggregator/quota-gatherer-heartbeat.json
Environment=QUOTA_GATHERER_STATE_PATH=%h/.local/state/pm-aggregator/quota-gatherer-state.json
Environment=QUOTA_SNAPSHOTS_DIR=%h/.local/state/pm-aggregator/snapshots
ExecStart=/run/current-system/sw/bin/bun run %h/git/code/pm-stack/aggregator/scripts/gather-quota.ts
