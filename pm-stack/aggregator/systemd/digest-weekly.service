[Unit]
Description=PM weekly digest — generate + archive + deliver the week's roll-up (pm-stack, #1278)
After=network-online.target pm-aggregator.service

[Service]
Type=oneshot
TimeoutStartSec=300
WorkingDirectory=%h/git/code/pm-stack/aggregator
Environment=PM_AGG_SOURCE=live
EnvironmentFile=%h/.local/state/pm-aggregator/.env
Environment=PM_AGG_DIGESTS_DIR=%h/.local/state/pm-aggregator/digests
ExecStart=/run/current-system/sw/bin/bun run %h/git/code/pm-stack/aggregator/scripts/generate-digest.ts --kind weekly
