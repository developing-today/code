{
  // A reviewable deployment candidate only. No credentials, live IDs or routes.
  // Gateway Forward must invoke GatewayMiddleware by RPC after explicit approval.
  "name": "private-laptop-bridge-staging",
  "main": "gateway.mjs",
  "compatibility_date": "2026-07-30",
  "workers_dev": false,
  "preview_urls": false,
  "limits": {"cpu_ms": 10},
  "observability": {"enabled": false},
  "routes": [],
  "vars": {
    "ENABLED": "false",
    "GATEWAY_HOST": "private-bridge-staging.invalid",
    "GATEWAY_ACCOUNT_ID": "",
    "GATEWAY_POLICY_ID": "",
    "GATEWAY_IDENTITY_EMAIL": "",
    "GATEWAY_POSTURE_ID": ""
  },
  "durable_objects": {"bindings": [{"name": "BRIDGE", "class_name": "PrivateLaptopBridge"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["PrivateLaptopBridge"]}]
}
