# PM projector — environment variable names only. Never commit real values.
# Real values live in SOPS (secrets/pm-stack.sops.yaml) + Bitwarden + 1Password.

# libSQL / Turso connection (defaults to file:data/projector.db when unset)
DATABASE_URL=
TURSO_AUTH_TOKEN=

# GitHub App credentials (reconciliation + webhook verification)
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=       # PEM, or base64 of the PEM
GITHUB_TOKEN=                 # fallback for repos the App can't reach

# API guard for link writes + reconcile
PM_PROJECTOR_API_TOKEN=

# Comma-separated repo allow-list
PM_REPOS=developing-today/code,developing-today/opencode,developing-today/openchamber,dezren39/nix

# HTTP
PORT=7801
HOSTNAME=127.0.0.1