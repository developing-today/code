+    /// Adds new member to group, welcoming them with no earlier secrets.
+    ///
+    /// `add` mints no secret, and its welcome carries the adder's whole bundle. This welcome
+    /// carries an empty bundle, so the joiner learns no secret the group had before the add. The
+    /// caller must follow with `update` to rotate to a secret the joiner does learn.
+    pub fn add_from_join(
+        mut y: GroupState<ID, OP, PKI, DGM, KMG, ORD>,
+        added: ID,
+        rng: &Rng,
+    ) -> GroupResult<ORD::Message, ID, OP, PKI, DGM, KMG, ORD> {
+        if !y.is_welcomed {
+            return Err(GroupError::GroupNotYetEstablished);
+        }
+
+        if y.my_id == added {
+            return Err(GroupError::NotAddOurselves);
+        }
+
+        // Pass an empty bundle, so the welcome carries no earlier secret.
+        let (y_dcgka_i, pre) = Dcgka::add(y.dcgka, added, &SecretBundle::init(), rng)?;
+        y.dcgka = y_dcgka_i;
+
+        Self::process_local(y, pre, None)
+    }
