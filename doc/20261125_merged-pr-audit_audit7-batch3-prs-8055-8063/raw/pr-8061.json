    "followers_url": "https://api.github.com/users/dezren39/followers",
    "following_url": "https://api.github.com/users/dezren39/following{/other_user}",
    "gists_url": "https://api.github.com/users/dezren39/gists{/gist_id}",
    "starred_url": "https://api.github.com/users/dezren39/starred{/owner}{/repo}",
    "subscriptions_url": "https://api.github.com/users/dezren39/subscriptions",
    "organizations_url": "https://api.github.com/users/dezren39/orgs",
    "repos_url": "https://api.github.com/users/dezren39/repos",
