  "title": "fix(id/web): unmatched backtick no longer disables newline-destination protection (#7557)",
  "user": {
    "login": "dezren39",
    "id": 11225574,
    "node_id": "MDQ6VXNlcjExMjI1NTc0",
    "avatar_url": "https://avatars.githubusercontent.com/u/11225574?v=4",
    "gravatar_id": "",
