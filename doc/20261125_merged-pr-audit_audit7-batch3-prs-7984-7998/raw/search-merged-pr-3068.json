b.com/dezren39","followers_url":"https://api.github.com/users/dezren39/followers","following_url":"https://api.github.com/users/dezren39/following{/other_user}","gists_url":"https://api.github.com/users/dezren39/gists{/gist_id}","starred_url":"https://api.github.com/users/dezren39/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dezren39/subscriptions","organizations_url":"https://api.github.com/users/dezren39/orgs","repos_url":"https://api.github.com/users/dezren39/repos","events_url":"https://api.github.com/users/dezren39/events{/privacy}","received_events_url":"https://api.github.com/users/dezren39/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":2,"created_at":"2026-11-02T06:50:57Z","updated_at":"2026-11-02T15:35:00Z","closed_at":"2026-11-02T15:34:56Z","assignee":{"login":"dezren39","id":11225574,"node_id":"MDQ6VXNlcjExMjI1NTc0","avatar_url":"https://avatars.githubusercontent.com/u/11225574?v=4","gravatar_id":"","url":"https://api.github.com/users/dezren39","html_url":"https://github.com/dezren39","followers_url":"https://api.github.com/users/dezren39/followers","following_url":"https://api.github.com/users/dezren39/following{/other_user}","gists_url":"https://api.github.com/users/dezren39/gists{/gist_id}","starred_url":"https://api.github.com/users/dezren39/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dezren39/subscriptions","organizations_url":"https://api.github.com/users/dezren39/orgs","repos_url":"https://api.github.com/users/dezren39/repos","events_url":"https://api.github.com/users/dezren39/events{/privacy}","received_events_url":"https://api.github.com/users/dezren39/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/developing-today/code/pulls/4236","html_url":"https://github.com/developing-today/code/pull/4236","diff_url":"https://github.com/developing-today/code/pull/4236.diff","patch_url":"https://github.com/developing-today/code/pull/4236.patch","merged_at":"2026-11-02T15:34:56Z"},"body":"## Summary\n\n```diff\nreceive(raw)\n  parse frame\n+ reject malformed top-level data visibly and in the log\n  switch on type\n+ validate snapshot/event shape before cursor, DOM or request changes\n  process valid frame\n```\n\nImplements the adopted Phase 3 fix for #2802 under #3068.\n\n## Evidence\n\n- **Before:** #2802 records real-module FakeSocket failures for missing snapshot participants, missing event kind and invalid sequence handling.\n- **After:** `bun run test -- src/world-records.test.ts` — 5 passed, including malformed frame and recovery cases.\n- Full package Vitest has 4 unrelated failures also reproduced on clean `main` (3 `world-contract.test.ts`, 1 `search-panel.test.ts`); typecheck has the same pre-existing `image-upload.test.ts:423` error on clean `main`.\n\n## Merge Danger\n\n**Door:** two-way\n\n**Blast Radius:** low\n\nOnly the world client receive boundary and its FakeSocket regression tests change.\n\n<!-- codesmith:footer -->\n---\n<a href=\"https://app.blacksmith.sh/developing-today/codesmith/code/pr/4236?autoLogin=true&ref=codesmith_pr_footer\"><picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://pr-comments-assets.blacksmith.sh/codesmith/view-with-codesmith-dark-v3.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://pr-comments-assets.blacksmith.sh/codesmith/view-with-codesmith-light-v3.svg\"><img alt=\"View with [code]smith\" src=\"https://pr-comments-assets.blacksmith.sh/codesmith/view-with-codesmith-dark-v3-3x.png\" width=\"162\" height=\"28\"></picture></a> <a href=\"https://backend.blacksmith.sh/track/enable-autofix?expires=1796194260&installation_model_id=443529&pr_number=4236&ref=codesmith_pr_footer&repository=developing-today%2Fcode&return_to=https%3A%2F%2Fgit