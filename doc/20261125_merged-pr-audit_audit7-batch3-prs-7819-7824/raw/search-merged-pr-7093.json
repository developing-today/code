%5D/subscriptions","organizations_url":"https://api.github.com/users/developing-today%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/developing-today%5Bbot%5D/repos","events_url":"https://api.github.com/users/developing-today%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/developing-today%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"labels":[],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":1,"created_at":"2026-11-08T21:55:20Z","updated_at":"2026-11-08T22:14:49Z","closed_at":"2026-11-08T22:14:47Z","assignee":null,"author_association":"CONTRIBUTOR","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/developing-today/code/pulls/7820","html_url":"https://github.com/developing-today/code/pull/7820","diff_url":"https://github.com/developing-today/code/pull/7820.diff","patch_url":"https://github.com/developing-today/code/pull/7820.patch","merged_at":"2026-11-08T22:14:47Z"},"body":"Drew direct order 2026-11-07 23:47 CST: \"make a glm 53 and flash-plan pools don't hook them anywhere and just add mistral for now too\" — clarified same evening: \"Just add vibe for now not mistral api.\"\n\nWhat this does (`.opencode/opencode.jsonc` only, +107 lines, nothing removed):\n\n- Declares `zai-glm-5-3` and `zai-glm-5-3-flash` on the `_vibe` provider (name + variants none/low/high/max, mirroring the `deepseek-v4-1-flash-1017` entry added to the same block earlier tonight). Both models are billed under Vibe Code on the account's Mistral usage page (verified there 2026-11-07); without a declaration the door cannot address them.\n- Defines `glm-5-3-plan` — sole member a direct `_vibe/zai-glm-5-3` leaf (`xhigh→max` remap), round-robin.\n- Defines `glm-5-3-flash-plan` — sole member a direct `_vibe/zai-glm-5-3-flash` leaf (`xhigh→max` remap), round-robin.\n\nDeliberately NOT done, per the order:\n\n- No `mistral-plan` route member and no `mistral` API member in either pool — `_vibe` only, so no draw can fall back to the account API budget (the failure just fixed in deepseek-flash-plan).\n- The pools are hooked nowhere: no route references them (`grep opencode-route/glm-5-3` = 0 hits). Definitions only.\n\nVerified pre-merge: JSONC parses; both pools present under `experimental.model_routes` with the single `_vibe` leaves; `_vibe` carries both model entries.\n\n<!-- codesmith:footer -->\n---\n<a href=\"https://backend.blacksmith.sh/track/enable-autofix?expires=1796766923&installation_model_id=443529&pr_number=7820&ref=codesmith_pr_footer&repository=developing-today%2Fcode&return_to=https%3A%2F%2Fgithub.com%2Fdeveloping-today%2Fcode%2Fpull%2F7820&signature=56e52009c1ef61dfb7ab1b9014ac987ef352285e3c6e800d9ef495040996b60e\"><picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://pr-comments-assets.blacksmith.sh/codesmith/autofix-with-codesmith-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://pr-comments-assets.blacksmith.sh/codesmith/autofix-with-codesmith-light.svg\"><img alt=\"Autofix with [code]smith\" src=\"https://pr-comments-assets.blacksmith.sh/codesmith/autofix-with-codesmith-dark-3x.png\" width=\"190\" height=\"28\"></picture></a>\n<sup><a href=\"https://app.blacksmith.sh/developing-today/codesmith/code/pr/7820?autoLogin=true&ref=codesmith_pr_footer\">Open in [code]smith</a> · Need help on this PR? Tag <code>@codesmith-bot</code> with what you need.</sup>\n\n<!-- codesmith:autofix:disabled -->\n<!-- /codesmith:footer -->","reactions":{"url":"https://api.github.com/repos/developing-today/code/issues/7820/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/developing-today/code/issues/7820/timeline","performed_via_github_app":null,"state_reason":null,"score":1.0},{"url":"https://api.github.com/repos/developing-today/code/issues/8502","repository_url":"https://api.github.com/repos/developing-today/code","labels_url":"https://api.github.com/repos/developing-today/code/issues/8502/labels{/name}","comments_url":"https://api.github.com/repos/developing-today/code/issues/8502/comments","events_url":"https://api.github.com/repos/developing-today/code/issues/8502/events","html_url":"https://github.com/developing-today/code/pull/8502","id":6321272696,"node_id":"PR_kwDOJWP4788AAAABOSGuqQ","number":8502,"title":"ci(yard-reaper): wire test_yard_reaper.py into a workflow venue + registry (#7879)","user":{"login":"dezren39","id":11225574,"node_id":"MDQ6VXNlcjExMjI1NTc0","avatar_url":"https://avatars.githubusercontent.com/u/11225574?v=4","gravatar_id":"","url":"https://api.github.com/users/dezren39","html_url":"https://github.com/dezren39","followers_url":"https://api.github.com/users/dezren39/followers","following_url":"https://api.github.com/users/dezren39/following{/other_user}","gists_url":"https://api.github.com/users/dezren39/gists{/gist_id}","starred_url":"https://api.github.com/users/dezren39/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dezren39/subscriptions","organizations_url":"https://api.github.com/users/dezren39/orgs","repos_url":"https://api.github.com/users/dezren39/repos","events_url":"https://api.github.com/users/dezren39/events{/privacy}","received_events_url":"https://api.github.com/users/dezren39/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[{"id":13198400136,"node_id":"LA_kwDOJWP4788AAAADEq-aiA","url":"https://api.github.com/repos/developing-today/code/labels/audit:complete","name":"audit:complete","color":"0e8a16","default":false,"description":"PR fully implemented spawning issue","archived_at":null,"archived_by":null}],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":2,"created_at":"2026-11-11T03:51:05Z","updated_at":"2026-11-24T06:24:33Z","closed_at":"2026-11-11T14:19:07Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/developing-today/code/pulls/8502","html_url":"https://github.com/developing-today/code/pull/8502","diff_url":"https://github.com/developing-today/code/pull/8502.diff","patch_url":"https://github.com/developing-today/code/pull/8502.patch","merged_at":"2026-11-11T14:19:07Z"},"body":"## Summary\n\nWires the yard-reaper's deletion-safety suite into CI (issue #7879, task 14225).\n\nThe yard-reaper runs hourly with `--apply` against the fleet scratch yard, but its 17 tests — the only thing pinning when it must NOT delete (oracle: Drew's 2026-11-07 disposition rule, #7093) — ran nowhere: no workflow, no flake check, no registry entry.\n\n- `.github/workflows/yard-reaper-tests.yml`: new workflow, path-gated on `infra/yard-reaper/**` (plus the workflow file itself), on pull_request, push to main, and workflow_dispatch. Modelled on `cold-store-reaper.yml` (including the #392 concurrency pattern). The job asserts the suite file exists first, then runs it explicitly.\n- `.github/test-suite-registry.json`: new entry `yard-reaper.python` naming the suite, venue, and invocation; status `mapped`.\n\nWiring only — no reaper behaviour changes, and the suite is unmodified.\n\n## Verification\n\n- Laptop, this branch: `python3 -m unittest discover -s infra/yard-reaper/tests` → Ran 17 tests, OK.\n- Registry JSON parses; the entry names `.github/workflows/yard-reaper-tests.yml` / `python-tests / Run the yard-reaper suite`.\n- Observed venue run: workflow_dispatch on this branch (linked in the PR checks / issue #7879 note once complete).\n\nRefs #7879 (does not close it until the venue run is observed; the completing note will say so).\n\n<!-- codesmith:footer -->\n---\n<a href=\"https://backend.blacksmith.sh/track/enable-autofix?expires=1796961069&installation_model_id=443529&pr_number=8502&ref=codesmith_pr_footer&repository=developing-today%2Fcode&return_to=https%3A%2F%2Fgithub.com%2Fdeveloping-today%2Fcode%2Fpull%2F8502&signature=1711840e59f9c81c4470cfc31fec6d408597d3c8bd8d29ae3c7b49fa7c69b088\"><picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://pr-comments-assets.blacksmith.sh/codesmith/autofix-with-codesmith-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://pr-comments-assets.blacksmith.sh/codesmith/autofix-with-codesmith-light.svg\"><img alt=\"Autofix with [code]smith\" src=\"https://pr-comments-assets.blacksmith.sh/codesmith/autofix-with-codesmith-dark-3x.png\" width=\"190\" height=\"28\"></picture></a>\n<sup><a href=\"https://app.blacksmith.sh/developing-today/codesmith/code/pr/8502?autoLogin=true&ref=codesmith_pr_footer\">Open in [code]smith</a> · Need help on this PR? Tag <code>@codesmith-bot</code> with what you need.</sup>\n\n<!-- codesmith:autofix:disabled -->\n<!-- /codesmith:footer -->","reactions":{"url":"https://api.github.com/repos/developing-today/code/issues/8502/reactions","total_count":1,"+1":1,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/developing-today/code/issues/8502/timeline","performed_via_github_app":null,"state_reason":null,"score":1.0},{"url":"https://api.github.com/repos/developing-today/code/issues/8089","repository_url":"https://api.github.com/repos/developing-today/code","labels_url":"https://api.github.com/repos/developing-today/code/issues/8089/labels{/name}","comments_url":"https://api.github.com/repos/developing-today/code/issues/8089/comments","events_url":"https://api.github.com/repos/developing-today/code/issues/8089/events","html_url":"https://github.com/developing-today/code/pull/8089","id":6297824341,"node_id":"PR_kwDOJWP4788AAAABN_UGYg","number":8089,"title":"mcpx(plugin): thread host abort signal through mcpx_exec (PLG-38, #1940)","user":{"login":"dezren39","id":11225574,"node_id":"MDQ6VXNlcjExMjI1NTc0","avatar_url":"https://avatars.githubusercontent.com/u/11225574?v=4","gravatar_id":"","url":"https://api.github.com/users/dezren39","html_url":"https://github.com/dezren39","followers_url":"https://api.github.com/users/dezren39/followers","following_url":"https://api.github.com/users/dezren39/following{/other_user}","gists_url":"https://api.github.com/users/dezren39/gists{/gist_id}","starred_url":"https://api.github.com/users/dezren39/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dezren39/subscriptions","organizations_url":"https://api.github.com/users/dezren39/orgs","repos_url":"https://api.github.com/users/dezren39/repos","events_url":"https://api.github.com/users/dezren39/events{/privacy}","received_events_url":"https://api.github.com/users/dezren39/received_events","type":"User","user_view_type":"public","site_admin":false},"labels":[],"state":"closed","locked":false,"assignees":[],"milestone":null,"comments":5,"created_at":"2026-11-10T00:52:44Z","updated_at":"2026-11-10T06:35:26Z","closed_at":"2026-11-10T06:35:23Z","assignee":null,"author_association":"MEMBER","issue_field_values":[],"type":null,"active_lock_reason":null,"draft":false,"pull_request":{"url":"https://api.github.com/repos/developing-today/code/pulls/8089","html_url":"https://github.com/developing-today/code/pull/8089","diff_url":"https://github.com/developing-today/code/pull/8089.diff","patch_url":"https://github.com/developing-today/code/pull/8089.patch","merged_at":"2026-11-10T06:35:23Z"},"body":"Queue task 13061, issue #1940 remainder.\n\nPLG-38: mcpx_exec ignored the host abort signal, so an aborted session blocked to completion. This threads ToolContext.abort through both paths:\n- Daemon path: DaemonClient.exec(source, session, signal) forwards the signal as CallOptions.signal to the generated daemon client, cancelling the in-flight /v1/exec request.\n- CLI fallback: viaCLI/runBin accept the signal; an already-aborted session never spawns the binary, and an abort mid-run kills the child and is named in the result instead of surfacing as a missing binary.\n- A daemon-path abort is caught in mcpx_exec and reported as an abort, not a daemon failure.\n\nCODE-53 needs no change here: the codemode:false user config example already landed on main in #7075 (docs/mcp.md), verified fresh this shift.\n\nTests:\n- bun test (plugin/opencode): 133 pass, 5 skip (live-daemon only), 0 fail. New: daemon-path abort against a fake daemon on a real socket (ops.test.ts), CLI-path abort plus a no-signal control (daemon.test.ts).\n- bunx tsc --noEmit: clean. biome lint on changed files: clean.\n- go test ./internal/mcpserver/ -run Codemode|CodeMode (pkgs/mcpx): pass.\n\nScope notes: the /v1 request-cancellation layer (#1864) and the v2 adapter are untouched, per the packet. #1940 should stay open if PLG-36/PLG-37 are later judged in-scope; this closes the CODE-53 + PLG-38 remainder.\n\n<!-- codesmith:footer -->\n---\n<a href=\"https://backend.blacksmith.sh/track/enable-autofix?expires=1796863968&installation_model_id=443529&pr_number=8089&ref=codesmith_pr_footer&repository=developing-today%2Fcode&return_to=https%3A%2F%2Fgithub.com%2Fdeveloping-today%2Fcode%2Fpull%2F8089&signature=c557511b87bef9dbcdd795d230b3be2a5924db2eea2dff5acdefc1a864585e00\"><picture><source media=\"(prefers-color-scheme: dark)\" srcset=\"https://pr-comments-assets.blacksmith.sh/codesmith/autofix-with-codesmith-dark.svg\"><source media=\"(prefers-color-scheme: light)\" srcset=\"https://pr-comments-assets.blacksmith.sh/codesmith/autofix-with-codesmith-light.svg\"><img alt=\"Autofix with [code]smith\" src=\"https://pr-comments-assets.blacksmith.sh/codesmith/autofix-with-codesmith-dark-3x.png\" width=\"190\" height=\"28\"></picture></a>\n<sup><a href=\"https://app.blacksmith.sh/developing-today/codesmith/code/pr/8089?autoLogin=true&ref=codesmith_pr_footer\">Open in [code]smith</a> · Need help on this PR? Tag <code>@codesmith-bot</code> with what you need.</sup>\n\n<!-- codesmith:autofix:disabled -->\n<!-- /codesmith:footer -->\n\n<!-- This is an auto-generated comment: release notes by coderabbit.ai -->\n\n<!-- coderabbit-ai-generated:v1 -->\n\n## Summary by CodeRabbit\n\n* **Bug Fixes**\n  * Cancelled tool requests now stop ongoing execution through either the daemon or command-line fallback, rather than continuing to run.\n  * If a request is cancelled before execution begins or while it is running, the tool now reports that it was aborted.\n\n<!-- end of auto-generated comment: release notes by coderabbit.ai -->","reactions":{"url":"https://api.github.com/repos/developing-today/code/issues/8089/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/developing-today/code/issues/8089/timeline","performed_via_github_app":null,"state_reason":null,"score":1.0}],"search_type":"lexical"}