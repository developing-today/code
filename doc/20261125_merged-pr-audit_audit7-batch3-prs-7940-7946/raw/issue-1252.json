VXNlcjExMjI1NTc0","avatar_url":"https://avatars.githubusercontent.com/u/11225574?v=4","gravatar_id":"","url":"https://api.github.com/users/dezren39","html_url":"https://github.com/dezren39","followers_url":"https://api.github.com/users/dezren39/followers","following_url":"https://api.github.com/users/dezren39/following{/other_user}","gists_url":"https://api.github.com/users/dezren39/gists{/gist_id}","starred_url":"https://api.github.com/users/dezren39/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dezren39/subscriptions","organizations_url":"https://api.github.com/users/dezren39/orgs","repos_url":"https://api.github.com/users/dezren39/repos","events_url":"https://api.github.com/users/dezren39/events{/privacy}","received_events_url":"https://api.github.com/users/dezren39/received_events","type":"User","user_view_type":"public","site_admin":false}],"milestone":null,"comments":16,"created_at":"2026-10-27T04:31:39Z","updated_at":"2026-11-17T07:03:38Z","closed_at":"2026-11-17T01:36:38Z","assignee":{"login":"dezren39","id":11225574,"node_id":"MDQ6VXNlcjExMjI1NTc0","avatar_url":"https://avatars.githubusercontent.com/u/11225574?v=4","gravatar_id":"","url":"https://api.github.com/users/dezren39","html_url":"https://github.com/dezren39","followers_url":"https://api.github.com/users/dezren39/followers","following_url":"https://api.github.com/users/dezren39/following{/other_user}","gists_url":"https://api.github.com/users/dezren39/gists{/gist_id}","starred_url":"https://api.github.com/users/dezren39/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dezren39/subscriptions","organizations_url":"https://api.github.com/users/dezren39/orgs","repos_url":"https://api.github.com/users/dezren39/repos","events_url":"https://api.github.com/users/dezren39/events{/privacy}","received_events_url":"https://api.github.com/users/dezren39/received_events","type":"User","user_view_type":"public","site_admin":false},"author_association":"MEMBER","issue_field_values":[],"type":null,"status":null,"active_lock_reason":null,"sub_issues_summary":{"total":3,"completed":3,"percent_completed":100},"parent_issue_url":"https://api.github.com/repos/developing-today/code/issues/1184","issue_dependencies_summary":{"blocked_by":0,"total_blocked_by":0,"blocking":0,"total_blocking":0},"body":"Part of epic #1184 (PM stack coherence — ideal-system design series, 2026-10-26).\n\n## Why\nToday the aggregator learns about the world from a fleet feed a sandbox collector republishes roughly every 5 minutes, and a stale feed renders indefinitely — freshness is bounded by the poll, and failures are silent until someone notices. An ideal stack is event-driven: GitHub webhooks and local service events push state changes to the aggregator, which pushes them to open browsers in seconds; polling survives only as a reconciliation backstop that proves the push path hasn't missed anything.\n\n## Design questions to answer\n- Which event sources are in scope v1 (GitHub webhooks via the existing App/tunnel, Kaneo webhooks, collector-local events, orchestration publishes) and what is the delivery path for each?\n- Transport to the browser: SSE vs WebSocket, per-page subscriptions, and how the machine-first JSON twins expose the same stream?\n- Ordering, dedupe, and replay: how does a reconnecting client catch up, and how does reconciliation detect a missed event?\n- Failure posture: when push is down, how is that surfaced (health page, freshness chips) and what poll interval is the fallback?\n- Auth: how are webhook signatures and browser subscriptions authenticated under the single-URL/Access model (#1182)?\n\n## Acceptance\n- Design note landed in repo `doc/` + implementation issues filed and linked as sub-issues of #1184; open questions needing Drew named explicitly in the design note.\n\n## Acceptance criteria\n- A design note is landed in the repo `doc/` answering the design questions above: v1 event sources and delivery paths, the browser transport (SSE vs WebSocket) and its JSON-twin exposure, ordering/dedupe/replay, the failure posture with polling as reconciliation only, and webhook/subscription auth under the #1182 Access model.\n- Implementation issues are filed and linked as sub-issues of #1184.\n- Open questions needing Drew are named explicitly in the design note.\n- The design states how a missed event is detected by reconciliation, and how push-down is surfaced on the health page / freshness chips.\n","closed_by":{"login":"dezren39","id":11225574,"node_id":"MDQ6VXNlcjExMjI1NTc0","avatar_url":"https://avatars.githubusercontent.com/u/11225574?v=4","gravatar_id":"","url":"https://api.github.com/users/dezren39","html_url":"https://github.com/dezren39","followers_url":"https://api.github.com/users/dezren39/followers","following_url":"https://api.github.com/users/dezren39/following{/other_user}","gists_url":"https://api.github.com/users/dezren39/gists{/gist_id}","starred_url":"https://api.github.com/users/dezren39/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/dezren39/subscriptions","organizations_url":"https://api.github.com/users/dezren39/orgs","repos_url":"https://api.github.com/users/dezren39/repos","events_url":"https://api.github.com/users/dezren39/events{/privacy}","received_events_url":"https://api.github.com/users/dezren39/received_events","type":"User","user_view_type":"public","site_admin":false},"reactions":{"url":"https://api.github.com/repos/developing-today/code/issues/1252/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"timeline_url":"https://api.github.com/repos/developing-today/code/issues/1252/timeline","performed_via_github_app":null,"state_reason":"completed","pinned_comment":null}