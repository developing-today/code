{
  "name": "id-web",
  "version": "0.1.0",
  "private": true,
  "description": "Web interface for id P2P file sharing",
  "type": "module",
  "scripts": {
    "build": "bun run build:js && bun run build:sw && bun run build:css && bun run build:manifest",
    "build:js": "bun build src/main.ts --outdir=dist --minify --sourcemap=external --entry-naming=[name].[hash].js",
    "build:sw": "bun build src/sw.ts --outdir=dist --minify --entry-naming=[name].js",
    "build:css": "node_modules/.bin/tailwindcss -i src/input.css -o dist/styles.css --minify",
    "build:manifest": "bun run scripts/build-manifest.ts",
    "dev": "bun build src/main.ts --outdir=dist --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@chenglou/pretext": "^1.0.0",
    "@starfederation/datastar": "^1.0.0-beta.11",
    "msgpackr": "^2.1.4",
    "prosemirror-collab": "^1.3.1",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-example-setup": "^1.2.4",
    "prosemirror-highlight": "^0.16.0",
    "prosemirror-history": "^1.5.2",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.13",
    "prosemirror-schema-basic": "^1.2.5",
    "prosemirror-schema-list": "^1.6.1",
    "prosemirror-search": "^1.1.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.44.0",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@types/node": "^26.6.6",
    "daisyui": "^5.8.2",
    "happy-dom": "^21.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
