{
  "name": "id-web",
  "version": "0.1.0",
  "private": true,
  "description": "Web interface for id P2P file sharing",
  "type": "module",
  "scripts": {
    "build": "bun run build:js && bun run build:css && bun run build:manifest",
    "build:js": "bun build src/main.ts --outdir=dist --minify --sourcemap=external --entry-naming=[name].[hash].js",
    "build:css": "node_modules/.bin/tailwindcss -i src/input.css -o dist/styles.css --minify",
    "build:manifest": "bun run scripts/build-manifest.ts",
    "dev": "bun build src/main.ts --outdir=dist --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.3",
    "@starfederation/datastar": "^1.0.0-beta.11",
    "msgpackr": "^1.12.1",
    "prosemirror-collab": "^1.3.1",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-example-setup": "^1.2.3",
    "prosemirror-highlight": "^0.15.3",
    "prosemirror-history": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-basic": "^1.2.5",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-search": "^1.1.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.6",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/node": "^20.19.43",
    "daisyui": "^5.7.47",
    "happy-dom": "^20.0.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
