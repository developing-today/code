{
  "$defs": {
    "case": {
      "additionalProperties": false,
      "properties": {
        "expect": { "$ref": "#/$defs/expectation" },
        "name": { "minLength": 1, "type": "string" },
        "required_capabilities": {
          "items": { "minLength": 1, "type": "string" },
          "type": "array",
          "uniqueItems": true
        },
        "steps": { "items": { "$ref": "#/$defs/step" }, "minItems": 1, "type": "array" }
      },
      "required": ["name", "required_capabilities", "steps", "expect"],
      "type": "object"
    },
    "expectation": {
      "additionalProperties": false,
      "properties": {
        "appended_records": { "minimum": 0, "type": "integer" },
        "final_offsets": { "items": { "minimum": 0, "type": "integer" }, "type": "array" },
        "negotiation": { "enum": ["granted", "unsupported_capability", "version_mismatch"], "type": "string" },
        "redelivery": { "type": "boolean" }
      },
      "type": "object"
    },
    "step": {
      "additionalProperties": false,
      "properties": {
        "consumer": { "type": "string" },
        "idempotency_key": { "type": ["string", "null"] },
        "max": { "minimum": 0, "type": "integer" },
        "offset": { "minimum": 0, "type": "integer" },
        "op": { "enum": ["negotiate", "append", "read", "ack"], "type": "string" },
        "operation_id": { "type": "string" },
        "payload_utf8": { "type": "string" }
      },
      "required": ["op"],
      "type": "object"
    }
  },
  "$id": "https://developing-today.github.io/code/id/test-vectors.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Shared test-vector files for port-contract conformance (slice 9110-02, #10160). Every adapter family runs the same vectors; a vector records the port, the capabilities the case requires, an ordered step trace, and the expected outcomes, so duplicate/retry/redelivery behavior is checked identically across adapters.",
  "properties": {
    "cases": { "items": { "$ref": "#/$defs/case" }, "minItems": 1, "type": "array" },
    "contract_version": { "minimum": 1, "type": "integer" },
    "port_kind": {
      "enum": [
        "record_store",
        "blob_store",
        "event_log",
        "world_store",
        "object_bucket",
        "message_stream",
        "request_transport"
      ],
      "type": "string"
    },
    "schema_version": { "const": 1, "type": "integer" }
  },
  "required": ["schema_version", "port_kind", "contract_version", "cases"],
  "title": "ID/Atlas shared conformance test vectors",
  "type": "object"
}
