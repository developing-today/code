{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pkgs/id/benchmarks/result-v1.schema.json",
  "title": "id-benchmarks result v1",
  "description": "One engine's benchmark result document for the #9133 benchmark contract (S2.1-S2.3, S2.16). Local (redb/Turso laptop) and cloud (D1/R2) evidence follow-ups in benchmark-plan.json both emit this shape; local values are not cloud-comparable, and no result recommends a shard configuration.",
  "type": "object",
  "required": ["schema_version", "workload_id", "engine", "dataset_digest", "environment", "metrics"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "workload_id": { "type": "string", "minLength": 1 },
    "engine": { "enum": ["d1", "r2", "redb", "turso"] },
    "dataset_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "environment": {
      "type": "object",
      "required": [
        "runner_version",
        "git_revision",
        "hardware_model",
        "cpu_count",
        "memory_bytes",
        "os_kernel",
        "runtime_versions",
        "start_time_utc",
        "cache_mode",
        "storage_shard_count",
        "dataset_digest"
      ],
      "additionalProperties": false,
      "properties": {
        "runner_version": { "type": "string", "minLength": 1 },
        "git_revision": { "type": "string", "minLength": 1 },
        "hardware_model": { "type": "string", "minLength": 1 },
        "cpu_count": { "type": "integer", "minimum": 1 },
        "memory_bytes": { "type": "integer", "minimum": 1 },
        "os_kernel": { "type": "string", "minLength": 1 },
        "runtime_versions": { "type": "object" },
        "start_time_utc": { "type": "string", "format": "date-time" },
        "cache_mode": { "enum": ["cold", "warm"] },
        "storage_shard_count": { "enum": [1, 4, 16, 64] },
        "dataset_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "metrics": {
      "type": "object",
      "required": ["p50_ms", "p95_ms", "p99_ms", "throughput_ops_s", "error_rate"],
      "additionalProperties": false,
      "properties": {
        "p50_ms": { "type": "number", "minimum": 0 },
        "p95_ms": { "type": "number", "minimum": 0 },
        "p99_ms": { "type": "number", "minimum": 0 },
        "throughput_ops_s": { "type": "number", "minimum": 0 },
        "error_rate": { "type": "number", "minimum": 0, "maximum": 1 },
        "native_billed_units": { "type": "number", "minimum": 0 },
        "durability_rpo": { "type": "string" },
        "replica_lag": { "type": "string" }
      }
    },
    "raw_samples": {
      "type": "array",
      "items": { "type": "number", "minimum": 0 }
    },
    "correctness": {
      "type": "object",
      "description": "The workload-oracle summary for the fixture the run used; a result whose correctness block is absent or failing is not evidence.",
      "required": ["fixture_digest_verified", "reference_transitions_executed_and_matched", "engine_operation_capability_mappings_checked"],
      "additionalProperties": false,
      "properties": {
        "fixture_digest_verified": { "type": "boolean" },
        "reference_transitions_executed_and_matched": { "type": "integer", "minimum": 0 },
        "engine_operation_capability_mappings_checked": { "type": "integer", "minimum": 0 },
        "timings_measured": { "type": "boolean" },
        "provider_calls": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
