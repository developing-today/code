{
  "name": "web",
  "version": "0.0.0",
  "description": "Frontend of the identity server",
  "license": "MIT",
  "browserslist": "> 0.5%, last 2 versions, not dead",
  "source": [
    "./assets/scripts.js",
    "./assets/styles.scss"
  ],
  "targets": {
    "default": {
      "distDir": "./static"
    }
  },
  "scripts": {
    "watch": "parcel watch",
    "fmt": "prettier --write .",
    "dev": "parcel build --no-optimize",
    "build": "parcel build"
  },
  "dependencies": {
    "@tailwindcss/typography": ">=0.5.10",
    "tailwindcss": ">=4.3.5",
    "daisyui": ">=5.8.2",
    "hyperscript.org": ">=0.9.12",
    "htmx.org": ">=2.0.11"
  },
  "devDependencies": {
    "@parcel/transformer-sass": ">=2.16.4",
    "parcel": ">=2.16.4",
    "prettier": ">=3.10.1"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "6.1.5"
    }
  }
}
