{
  // d1-gateway: Turso/libSQL-compatible endpoint over D1 (see src/index.js).
  // Deployed only through the versions flow in deploy.sh
  // (.github/workflows/d1-gateway-deploy.yml, nix run .#d1-gateway-deploy).
  "name": "d1-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "observability": { "enabled": true },
  // Run near the databases (all in ENAM), not near each caller.
  "placement": { "mode": "smart" },
  "limits": { "cpu_ms": 300000 },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "vars": {
    // SHA-256 (hex) of each bearer token a database accepts. The tokens
    // are the existing turso.<db> Bitwarden entries, so a Turso client
    // moves by changing only its URL. Hashes only, never values.
    "TOKEN_SHA256": {
      "fleet-queue": ["10ba834aa8e606a67b86ba8185ae780d23b67dc1864cdf8e6bc8892008529082"],
      "fleet-platform": ["61caea8c989f063dd664893acb366be790b398fc01ab027e6f62c5ea591a0df0"],
      "fleet-dispatch-jobs": ["b4c44dcda0d8a1334c30659ed430f795accecdd95ad3d6262bd9763c5acf1040"],
      "fleet-mirror": [
        "2ed358bd75577c6313db740b9fa0bf9ff58b133fb0967ce909a6a7c0aa03dfa6",
        "6320fec2c879a8328a50ac851494bbee3f606cf73d7b20259dc7915263278623"
      ],
      "voice-line-ledger": [],
      "bedside-and-away": []
    }
  },
  "d1_databases": [
    { "binding": "DB_FLEET_QUEUE", "database_name": "fleet-queue", "database_id": "c17186b0-e27f-4b0b-9429-54c1ecf2f4fb" },
    { "binding": "DB_FLEET_PLATFORM", "database_name": "fleet-platform", "database_id": "57d15925-b0b8-4466-a92c-c200a6af4c45" },
    { "binding": "DB_FLEET_DISPATCH_JOBS", "database_name": "fleet-dispatch-jobs", "database_id": "0beba01a-cb88-45eb-b0f6-7d69e961d04f" },
    { "binding": "DB_FLEET_MIRROR", "database_name": "fleet-mirror", "database_id": "e663388d-b856-4cf5-b8a8-bae8bf097174" },
    { "binding": "DB_VOICE_LINE_LEDGER", "database_name": "voice-line-ledger", "database_id": "1a405524-b01e-4984-92f3-f5f45348f550" },
    { "binding": "DB_BEDSIDE_AND_AWAY", "database_name": "bedside-and-away", "database_id": "21294d74-7449-44e7-9945-9bdbab1a5c84" }
  ]
}
