# A container that builds mcpx and runs it.
#
# Deliberately ordinary: a Go builder, a Debian runtime, and a JavaScript
# runtime copied in. It is a starting point, not the image anyone would ship
# -- see docs/container.md for what is missing and why it is missing on
# purpose.
#
# Build:  docker build -f Containerfile -t mcpx .
# Run:    docker run --rm -v "$PWD/.mcpx.json:/work/.mcpx.json:ro" mcpx ls

# Pinned by tag and digest. The tag says what it is and the digest says which
# one, because a tag moves and a reproducible build cannot depend on when it
# ran.
ARG GO_IMAGE=golang:1.27-bookworm@sha256:972b4110ba0f47539a975c31e52c64765e1ff19f2d74469ae4a595c6676e80a5
ARG BUN_IMAGE=oven/bun:1-debian@sha256:93d5032fe06d163427822dc1598f420363759bb18155c9cc90eb1be05a64a19e
ARG RUNTIME_IMAGE=debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8

# ---- build ----------------------------------------------------------------

FROM ${GO_IMAGE} AS build

# The mcpx this image ships is a static build (#1987). Flipping this to 0
# was tested rather than guessed: it builds, the binary is fully static
# ("not a dynamic executable"), it is the same size to within a hundred
# bytes, and `--version`, `ls`, `call` and `exec` all work. The behavioural
# change is real but external: pure-Go os/user parses /etc/passwd instead
# of asking NSS, and the resolver stops honouring nsswitch.conf. Neither
# matters inside this image; both matter to somebody on a host, so the
# host artifacts keep their own policy -- docs/container.md section 4 has
# the measurements and the policy record. The runtime stage is still the
# same Debian the builder uses, but no longer because mcpx needs its
# glibc: bun (below) is a dynamically linked distribution binary.
# Pass --build-arg CGO_ENABLED=1 for the old glibc-linked build.
ARG CGO_ENABLED=0
# The version's single source is pkgs/mcpx/VERSION (decision 0005 §3);
# the release workflow passes its contents as --build-arg VERSION=...
# The default here is the dev sentinel, matching cmd/mcpx/main.go, so
# a plain `docker build` does not impersonate a release.
ARG VERSION=0.0.0-dev
ENV CGO_ENABLED=${CGO_ENABLED}

WORKDIR /src

# Dependencies first, so editing Go files does not re-download the module
# cache.
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" -o /out/mcpx ./cmd/mcpx

# A static default that silently stops being static is worse than none:
# fail the image build if the binary does not record the CGO_ENABLED it
# was built with.
RUN go version -m /out/mcpx | grep -q "CGO_ENABLED=${CGO_ENABLED}"

# ---- javascript runtime ---------------------------------------------------

# Bun, taken from its own image rather than downloaded, so the version is
# pinned by the same digest mechanism as everything else and the build does
# not depend on a release URL still being there.
FROM ${BUN_IMAGE} AS bun

# ---- runtime --------------------------------------------------------------

FROM ${RUNTIME_IMAGE}

# No git. The `repo` and `worktree` sharing scopes find a repository by
# reading .git themselves (internal/config/gitdiscover.go), and git -- 105 MB
# here, mostly perl -- is only a fallback for repository layouts that reader
# does not vouch for. Without it those rare layouts key by directory and
# `mcpx doctor` says why; docs/git-discovery.md has the list. ca-certificates
# is for the registry.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
COPY --from=build /out/mcpx /usr/local/bin/mcpx

# mcpx picks the first of deno, bun, node on PATH, so shipping exactly one
# makes the choice unambiguous. `script.runtime` (MCPX_SCRIPT_RUNTIME,
# --script-runtime) overrides it, and naming a runtime that is not in the
# image is an error rather than a fallback.
ENV MCPX_SCRIPT_RUNTIME=bun

# Nothing here needs root, and a daemon that owns arbitrary MCP server
# processes is the last thing that should have it.
RUN useradd --create-home --uid 1000 mcpx
USER mcpx
WORKDIR /work

ENV MCPX_STATE_DIR=/home/mcpx/.local/state/mcpx \
    MCPX_CACHE_DIR=/home/mcpx/.cache/mcpx

ENTRYPOINT ["mcpx"]
CMD ["--help"]
