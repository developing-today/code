{
  // Message bridge Worker: a remote MCP connector for Claude plus a
  // history page. This file drives local `wrangler dev` (and cf's
  // build delegation); deployment goes through cloudflare.config.ts and
  // the cf versions flow (nix run .#message-bridge-deploy). The two
  // configs describe the same Worker and must be kept in step (a test
  // checks the main fields).
  "name": "message-bridge",
  "main": "src/index.js",
  "compatibility_date": "2026-10-25",
  "observability": { "enabled": true },
  "vars": {
    // The address the connectors and the page use: a Workers custom
    // domain (this URL's host) that deploy.mjs attaches, and keeps
    // attached, on every deploy.
    "PUBLIC_URL": "https://bridge.security.cab",
    // Always answers too; deploy.mjs checks /healthz here, since a new
    // custom domain can take a while to get its certificate.
    "WORKERS_DEV_URL": "https://message-bridge.developing-today.workers.dev"
  },
  // Secrets (uploaded by deploy.mjs from Bitwarden, never in this file):
  //   ACCESS_TOKEN   the owner's path token: /mcp (Claude), /p and /api
  //   CHATGPT_TOKEN  the ChatGPT connector's token: its /mcp only
  // Lets /healthz report which version is answering (deploy.mjs waits for it).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "durable_objects": {
    "bindings": [{ "name": "MESSAGES", "class_name": "MessageStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MessageStore"] }]
}
