{
  "name": "grok-dev",
  "version": "1.1.7",
  "description": "An open-source AI coding agent powered by Grok, built with Bun and OpenTUI.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "grok": "dist/index.js"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,json}": "biome check --write --no-errors-on-unmatched"
  },
  "keywords": [
    "cli",
    "agent",
    "grok",
    "ai",
    "coding",
    "terminal",
    "opentui"
  ],
  "author": "Vibe Kit",
  "license": "MIT",
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.102",
    "@ai-sdk/provider-utils": "^5.0.83",
    "@ai-sdk/xai": "^5.0.48",
    "@coinbase/agentkit": "^0.10.4",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@npmcli/arborist": "^10.0.5",
    "@opentui/core": "^0.9.7",
    "@opentui/react": "^0.9.7",
    "agent-desktop": "^1.3.1",
    "ai": "^7.0.179",
    "commander": "^15.1.0",
    "diff": "^9.0.0",
    "dotenv": "^18.0.10",
    "grammy": "^1.41.1",
    "react": "^19.2.4",
    "ripgrep": "^0.3.1",
    "semver": "^7.7.4",
    "vscode-jsonrpc": "^10.0.1",
    "vscode-languageserver-types": "^3.17.5",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "preferGlobal": true
}
