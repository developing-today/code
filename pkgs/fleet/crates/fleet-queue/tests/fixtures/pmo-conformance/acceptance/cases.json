  "known_mismatches": [
    {
      "id": "C1",
      "detail": "the forwarded envelope carries args; operations::Command has no arguments field, so the /fleet priority argument is dropped at the Fleet boundary",
      "owner": "REL-03 section 3.2, DSP-02"
    },
    {
      "id": "C2",
      "detail": "edited comments forward under the same key, so an edited /fleet priority value is accepted as a duplicate of the old one",
      "owner": "REL-03 section 7"
    }
  ]
}
