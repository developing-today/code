{
  "family": "acceptance",
  "projector_source": "pm-stack/projector/src/operation-forwarder.ts",
  "key_template": "ghcmd:v1:${repo}#${issue}:comment:${comment.id}:${command.verb}",
  "forwarded_envelope_fields": [
    "idempotencyKey",
    "deliveryId",
    "event",
    "actor",
    "verb",
    "args",
    "repo",
    "issue",
    "commentId"
  ],
  "inert_default_wiring": {
    "note": "no projector entry point attaches a Fleet sink: only server.ts, which declares the optional dependency, names it",
    "projector_src_dir": "pm-stack/projector/src",
    "token": "operationSink",
    "only_file": "server.ts"
  },
  "policy": {
    "grants": [
      {
        "principal": "octocat",
        "verbs": [
          "status",
          "priority"
        ],
        "repos": [
          "octo-org/widgets"
        ]
      },
      {
        "principal": "hubot",
        "verbs": [
          "status"
        ],
        "repos": [
          "octo-org/elsewhere"
        ]
      }
    ]
  },
  "deliveries": [
    {
      "name": "first_delivery",
      "delivery_id": "d-0001",
      "event": "issue_comment",
      "payload": {
        "action": "created",
        "repository": {
          "full_name": "octo-org/widgets"
        },
        "issue": {
          "number": 42
        },
        "comment": {
          "id": 9001,
          "body": "/fleet status",
          "user": {
            "login": "octocat"
          }
        },
        "sender": {
          "login": "octocat"
        }
      },
      "projection_applied": true,
      "forwarded": {
        "idempotencyKey": "ghcmd:v1:octo-org/widgets#42:comment:9001:status",
        "deliveryId": "d-0001",
        "event": "issue_comment",
        "actor": "octocat",
        "verb": "status",
        "args": "",
        "repo": "octo-org/widgets",
        "issue": 42,
        "commentId": 9001
      },
      "expected": {
        "accepted": true,
        "duplicate": false,
        "sequence": 1,
        "effects_after": 1
      }
    },
    {
