{
  "schema": "fleet.pki.dns-policy/v1",
  "caa": [
    {
      "name": "pki",
      "issue": ["letsencrypt.org"],
      "iodef": "mailto:pki@example.test"
    }
  ],
  "tlsa": [
    {
      "host": "svc",
      "port": 443,
      "bundle": "svc-leaf",
      "endpoint": "the svc process on the fixture host"
    },
    {
      "host": "ca.example.test.",
      "port": 8443,
      "bundle": "Base",
      "usage": 2,
      "algorithm": "ed25519",
      "partition": "a"
    }
  ]
}
