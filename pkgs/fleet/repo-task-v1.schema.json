{
  "$id": "repo-task/v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [{
    "if": {
      "required": ["risk"],
      "properties": {"risk": {
        "required": ["flags"],
        "properties": {"flags": {"contains": {"const": "cross-repo-change"}}}
      }}
    },
    "then": {"required": ["implementation_repo"]}
  }],
  "$defs": {
    "completion_telemetry": {
      "type": "object",
      "additionalProperties": false,
      "description": "Fleet telemetry recorded by the completing worker on a task's completion result (issue #1582, meta-reviewer #1340 follow-up). Since #4919 repo-queue complete fills all four fields itself when the caller leaves them out, so they no longer depend on a worker passing --telemetry: model and effort come from the claim stamp (else the completing session's serving leaf), pool from the session's declared opencode-route model, and cost_usd stays null because no cost readout is sourceable. An explicit caller value always wins. A field is null when no source exposes it. effort is recorded only from resolved session messages, never inferred from route names (meta-reviewer guideline 2026-10-27).",
      "properties": {
        "pool": { "type": ["string", "null"], "minLength": 1 },
        "model": { "type": ["string", "null"], "minLength": 1 },
        "effort": { "type": ["string", "null"], "minLength": 1 },
        "cost_usd": { "type": ["number", "null"], "minimum": 0 }
      }
    },
    "completion_result": {
      "type": "object",
      "description": "Shape of the result object stored by repo-queue.py complete (agent.tasks.result). The outcome fields are defined by the worker runbook section 6; the four telemetry fields from completion_telemetry also appear at the top level, defaulted by repo-queue complete since #4919 (explicit caller values win).",
      "properties": {
        "pool": { "$ref": "#/$defs/completion_telemetry/properties/pool" },
        "model": { "$ref": "#/$defs/completion_telemetry/properties/model" },
        "effort": { "$ref": "#/$defs/completion_telemetry/properties/effort" },
        "cost_usd": { "$ref": "#/$defs/completion_telemetry/properties/cost_usd" }
      }
    }
  },
  "additionalProperties": true,
  "anyOf": [
    { "required": ["issue"] },
    { "properties": { "prs": { "minItems": 1 } }, "required": ["prs"] },
    { "required": ["set"] },
    { "required": ["source"] }
  ],
  "description": "Structured payload stored in agent.tasks.payload for repo-health queue tasks. The task-row envelope fields (title, body, dedupe_key, priority, not_before, max_attempts) live outside this payload and are validated by repo-queue.py together with the cross-field dedupe rules.",
  "properties": {
    "acceptance": { "items": { "minLength": 1, "type": "string" }, "minItems": 1, "type": "array" },
    "context_refs": { "items": { "type": "string" }, "type": "array" },
    "dedupe": {
      "additionalProperties": true,
      "properties": {
        "basis": { "minLength": 1, "type": "string" },
        "checked_at": { "minLength": 1, "type": "string" }
      },
      "required": ["checked_at", "basis"],
      "type": "object"
    },
    "evidence": { "items": { "minLength": 1, "type": "string" }, "minItems": 1, "type": "array" },
    "issue": {
      "additionalProperties": true,
      "properties": {
        "number": { "minimum": 1, "type": "integer" },
        "state_checked_at": { "minLength": 1, "type": "string" },
        "title": { "type": "string" },
        "url": { "minLength": 1, "type": "string" }
      },
      "required": ["number"],
      "type": "object"
    },
    "kind": { "enum": ["pr_shepherd", "triage", "small_fix", "ci_investigation"], "type": "string" },
    "max_attempts": { "maximum": 10, "minimum": 1, "type": "integer" },
    "priority_reason": { "minLength": 1, "type": "string" },
    "problem": { "minLength": 1, "type": "string" },
    "prs": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "number": { "minimum": 1, "type": "integer" },
          "title": { "type": "string" },
          "url": { "type": "string" }
        },
        "required": ["number"],
        "type": "object"
      },
      "type": "array"
    },
    "implementation_repo": {
      "description": "Repository receiving the implementation when different from the issue-tracking repo. Claim repo filters use this field first; issue/dedupe identity remains repo. Explicit owner/name, not a URL.",
      "type": "string",
      "pattern": "^(?![.]{1,2}/)[A-Za-z0-9_.-]+/(?![.]{1,2}$)[A-Za-z0-9_.-]+$"
    },
    "repo": {
      "enum": [
        "developing-today/code",
        "developing-today/opencode",
        "developing-today/openchamber",
        "developing-today-forks/opencode",
        "developing-today-forks/openchamber",
        "dezren39/darwin-nix",
        "developing-today/zettel",
        "dezren39/dezren39"
      ]
    },
    "risk": {
      "additionalProperties": true,
      "properties": {
        "flags": { "items": { "type": "string" }, "type": "array" },
        "level": { "enum": ["low", "medium", "high"], "type": "string" }
      },
      "required": ["level", "flags"],
      "type": "object"
    },
    "schema": { "const": "repo-task/v1" },
    "scope": {
      "additionalProperties": true,
      "properties": {
        "exclude": { "items": { "minLength": 1, "type": "string" }, "minItems": 1, "type": "array" },
        "include": { "items": { "minLength": 1, "type": "string" }, "type": "array" }
      },
      "required": ["include", "exclude"],
      "type": "object"
    },
    "set": {
      "additionalProperties": true,
      "properties": {
        "origin_issue": { "minimum": 1, "type": "integer" },
        "prs": { "items": { "minimum": 1, "type": "integer" }, "type": "array" }
      },
      "type": ["object", "null"]
    },
    "source": {
      "additionalProperties": true,
      "description": "Pre-filing triage identity: the review source a finding came from, used instead of a filed issue.",
      "properties": { "finding": { "minLength": 1, "type": "string" }, "pr": { "minimum": 1, "type": "integer" } },
      "required": ["pr", "finding"],
      "type": "object"
    },
    "tests": { "items": { "minLength": 1, "type": "string" }, "minItems": 1, "type": "array" },
    "timebox_minutes": { "maximum": 240, "minimum": 1, "type": "integer" },
    "required_budget_minutes": {
      "type": "integer",
      "minimum": 1,
      "description": "Optional minimum uninterrupted budget in minutes to reach the next safe checkpoint (#3418). Absent means no requirement (legacy claim behavior)."
    }
  },
  "required": [
    "schema",
    "kind",
    "repo",
    "problem",
    "evidence",
    "acceptance",
    "scope",
    "tests",
    "risk",
    "priority_reason",
    "timebox_minutes",
    "max_attempts",
    "context_refs",
    "dedupe"
  ],
  "title": "repo-task/v1 task packet payload (queue/worker pilot, fleet repos)",
  "type": "object"
}
