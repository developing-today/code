def ledger_reserve(kind: str, repo: str):
    """Reserve a ledger row for this post; die(5) if the ledger is down."""
    if content_ledger is None:
        die(f"content-ledger module unavailable ({_LEDGER_IMPORT_ERROR}); "
            "refusing to post unledgered (hatch#3)", 5)
    nonce = content_ledger.new_nonce()
    try:
        led = content_ledger.Ledger()
        row = led.reserve(actor="dezren39",
                          job=os.environ.get("FLEET_JOB", "gh-post"),
                          repo=repo, kind=kind, nonce=nonce)
    except content_ledger.LedgerError as e:
        die(f"content-ledger reserve failed ({e}); "
            "refusing to post unledgered (hatch#3)", 5)
    return led, row, nonce


def ledger_finalize(led, row: int, outcome: str, ref: str | None = None,
                    detail: str | None = None,
                    actor: str | None = None) -> None:
    try:
        led.finalize(row, outcome, ref=ref, detail=detail, actor=actor)
    except content_ledger.LedgerError as e:
        print(f"gh-post: LEDGER FINALIZE FAILED for row {row} "
              f"(outcome {outcome}): {e}", file=sys.stderr)
        raise SystemExit(5)


def effective_body_file(body_file: Path, nonce: str) -> Path:
    """The body actually posted: the caller's body + the nonce marker."""
    raw = body_file.read_text(errors="replace")
    fd, name = tempfile.mkstemp(prefix="gh-post-body-", suffix=".md")
    with os.fdopen(fd, "w") as f:
        f.write(raw.rstrip("\n") + f"\n\n<!-- fleet-nonce:{nonce} -->\n")
    atexit.register(lambda: os.path.exists(name) and os.unlink(name))
    return Path(name)


# --- Content throttle (dezren39/hatch#13) ----------------------------------
sys.path.insert(0, str(Path(__file__).resolve().parent / "content-throttle"))
try:
    import content_throttle
    _THROTTLE_IMPORT_ERROR = None
except Exception as _e:  # noqa: BLE001 — reported fatally at post time
    content_throttle = None
    _THROTTLE_IMPORT_ERROR = _e


def throttle_acquire(kind: str, repo: str):
    """Pass the throttle gate before posting; die(5/6) if it cannot.

    Returns (throttle, circuit_until_iso_or_None, outcome_holder). The
    slot is released via atexit with the holder's final outcome, so
    every exit path (return, die, exception) releases exactly once.
    When the circuit is open the acquire has already released its
    slot; the caller must then treat the user leg as rate-limited
    WITHOUT attempting it — the App leg is a different rate-limit
    bucket (Drew's rule) and the outbox remains available.
    """
    if content_throttle is None:
        die(f"content-throttle module unavailable "
            f"({_THROTTLE_IMPORT_ERROR}); refusing to post unthrottled "
            "(hatch#13)", 5)
    try:
        th = content_throttle.Throttle()
    except content_throttle.ThrottleError as e:
        die(f"content-throttle unavailable ({e}); refusing to post "
            "unthrottled (hatch#13)", 5)
    holder = {"outcome": "failed"}
    job = os.environ.get("FLEET_JOB", "gh-post")
    try:
        slot = th.acquire(job, kind, repo)
    except content_throttle.CircuitOpen as e:
        return th, content_throttle.iso(e.open_until), holder
    except content_throttle.ThrottleRefused as e:
        die(str(e), 6)
    except content_throttle.ThrottleError as e:
        die(f"content-throttle acquire failed ({e}); refusing to post "
            "unthrottled (hatch#13)", 5)

    def _release():
        try:
            th.release(slot, holder["outcome"])
        except Exception as ex:  # noqa: BLE001 — slot self-expires anyway
            print(f"gh-post: WARNING: throttle slot {slot} release "
                  f"failed ({ex}); it expires on its own",
                  file=sys.stderr)

    atexit.register(_release)
    return th, None, holder


def throttle_note_user_outcome(th, outcome: str) -> None:
    """Feed the user leg's result to the circuit breaker (hatch#13).

    Only called when the user leg actually ran: a posted result clears
    the consecutive-failure count; a rate-limit result counts toward
    the five that open the circuit. The App leg is a different bucket
    and is not counted here.
    """
    try:
        if outcome == "posted":
            th.record_success()
        elif outcome == "limited":
            th.record_failure()
    except content_throttle.ThrottleError as e:
        print(f"gh-post: WARNING: circuit-breaker update failed ({e})",
              file=sys.stderr)


# --- Live notes (dezren39/hatch#13, spec item 5) -----------------------------
def note_marker(key: str) -> str:
    return f"<!-- fleet-live-note:{key} -->"


def find_live_note(repo: str, number: int, key: str):
    """The existing live-note comment object for (target, key), or None.

    A failed list call dies visibly: guessing "not found" would create
    a second live note, which is exactly what item 5 exists to end.
    """
    r = run(["gh", "api",
             f"repos/{repo}/issues/{number}/comments?per_page=100"])
    if r.returncode != 0:
        die(f"live-note lookup failed: {(r.stderr or '')[-300:]}")
    try:
        items = json.loads(r.stdout)
    except json.JSONDecodeError:
        die("live-note lookup returned unparsable JSON")
    marker = note_marker(key)
    for it in items:
        if marker in (it.get("body") or ""):
            return it
    return None

# --- Pre-post secret scan (code#7072) -------------------------------------
# Findings name the pattern class and line number only — never the value.
TOKEN_PREFIX_RES = [
    ("github-token", re.compile(r"gh[pousr]_[A-Za-z0-9]{20,}")),
    ("github-pat", re.compile(r"github_pat_[A-Za-z0-9_]{20,}")),
    ("aws-access-key", re.compile(r"\b(?:AKIA|ASIA)[0-9A-Z]{16}\b")),
    ("openai-style-key", re.compile(r"\bsk-[A-Za-z0-9_-]{20,}")),
    ("slack-token", re.compile(r"\bxox[baprs]-[A-Za-z0-9-]{10,}")),
    ("private-key-block", re.compile(r"-----BEGIN (?:[A-Z]+ )?PRIVATE KEY-----")),
    ("bearer-token", re.compile(r"\bBearer\s+[A-Za-z0-9._~+/=-]{20,}")),
]
CRED_KEY_RE = re.compile(
    r"^\s*(?:export\s+)?([A-Za-z0-9_]*(?:KEY|TOKEN|SECRET|PASSWORD|PASSWD|"
    r"CREDENTIAL|PRIVATE|AUTH)[A-Za-z0-9_]*)\s*=\s*(\S.{7,})$"
)
ENV_LINE_RE = re.compile(r"^\s*(?:export\s+)?[A-Z_][A-Z0-9_]{2,}=\S+")
PLACEHOLDER_RE = re.compile(
    r"^(?:<[^>]*>|\.\.\.|…|\*+|x+|REDACTED|redacted|example|EXAMPLE|"
    r"your[-_ ].*|changeme|CHANGE_ME|\"[^\"]*\"|'[^']*')$"
)
ENV_DUMP_THRESHOLD = 5


def scan_body(text: str) -> list[str]:
    """Return findings for credential-shaped body text (values redacted)."""
    findings: list[str] = []
    env_lines = 0
    for n, line in enumerate(text.splitlines(), 1):
        for name, rx in TOKEN_PREFIX_RES:
            if rx.search(line):
                findings.append(f"line {n}: {name}")
        m = CRED_KEY_RE.match(line)
        if m and not PLACEHOLDER_RE.match(m.group(2).strip()):
            findings.append(f"line {n}: credential assignment ({m.group(1)}=…)")
        if ENV_LINE_RE.match(line):
            env_lines += 1
    if env_lines >= ENV_DUMP_THRESHOLD:
        findings.append(
            f"env-dump shape: {env_lines} KEY=value lines "
            f"(threshold {ENV_DUMP_THRESHOLD})"
        )
    return findings


def enforce_scan(body_file: Path) -> None:
    findings = scan_body(body_file.read_text(errors="replace"))
    if findings:
        print("gh-post: BLOCKED by pre-post secret scan (code#7072):",
              file=sys.stderr)
        for f in findings:
            print(f"  - {f}", file=sys.stderr)
        print("gh-post: remove the credential-shaped text and re-run; "
              "values are never printed by this scan.", file=sys.stderr)
        raise SystemExit(4)


def run(cmd: list[str], **kw) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def die(msg: str, code: int = 1) -> "SystemExit":
    print(f"gh-post: {msg}", file=sys.stderr)
    raise SystemExit(code)


def is_limit(text: str) -> bool:
    return bool(LIMIT_RE.search(text or ""))


def body_norm(p: Path) -> str:
    return p.read_text().rstrip("\n")


def find_comment_by_body(repo: str, number: int, body: str) -> str | None:
    """Readback search: a recent comment on the target with this exact body."""
    r = run(
        [
            "gh", "api", f"repos/{repo}/issues/{number}/comments",
            "--jq", ".[-8:] | .[] | [.id, .html_url] | @tsv",
        ]
    )
    if r.returncode != 0:
        return None
    for line in r.stdout.strip().splitlines():
        if not line.strip():
            continue
        cid, url = line.split("\t")
        got = run(["gh", "api", f"repos/{repo}/issues/comments/{cid}", "--jq", ".body"])
        if got.returncode == 0 and got.stdout.rstrip("\n") == body:
            return url
    return None


def leg_user_comment(repo: str, number: int, pr: bool, body_file: Path) -> tuple[str, str]:
    """Returns (outcome, detail): outcome in posted|limited|error."""
    cmd = ["gh", "pr" if pr else "issue", "comment", str(number),
           "--repo", repo, "--body-file", str(body_file)]
    r = run(cmd)
    out = (r.stdout or "") + (r.stderr or "")
    m = URL_RE.search(r.stdout or "")
    if r.returncode == 0 and m:
        url = m.group(0)
        cid = re.search(r"issuecomment-(\d+)", url)
        if cid:
            got = run(["gh", "api", f"repos/{repo}/issues/comments/{cid.group(1)}",
                       "--jq", ".body"])
            if got.returncode != 0 or got.stdout.rstrip("\n") != body_norm(body_file):
                return ("error", f"user-leg readback mismatch for {url}")
        print(f"posted (user): {url}")
        return ("posted", url)
    if is_limit(out):
        # gh can fail after the post landed; check before falling through.
        found = find_comment_by_body(repo, number, body_norm(body_file))
        if found:
            print(f"posted (user, recovered by readback): {found}")
            return ("posted", found)
        return ("limited", out.strip()[-300:])
    return ("error", out.strip()[-500:] or f"gh exited {r.returncode}")


def leg_user_create(repo: str, title: str, body_file: Path, labels: list[str]) -> tuple[str, str]:
    cmd = ["gh", "issue", "create", "--repo", repo, "--title", title,
           "--body-file", str(body_file)]
    for lab in labels:
        cmd += ["--label", lab]
    r = run(cmd)
    out = (r.stdout or "") + (r.stderr or "")
    m = URL_RE.search(r.stdout or "")
    if r.returncode == 0 and m:
        print(f"posted (user): {m.group(0)}")
        return ("posted", m.group(0))
    if is_limit(out) or (r.returncode == 0 and not m):
        # Empty-success is gh's known silent-loss mode; the App leg dedupes
        # by exact title, so falling through cannot double-file.
        return ("limited", out.strip()[-300:] or "gh exited 0 with no URL")
    return ("error", out.strip()[-500:] or f"gh exited {r.returncode}")


def laptop_paperwork(args: list[str], body_file: Path) -> tuple[bool, str]:
    """Run fleet_paperwork on the laptop with the body file shipped over."""
    remote_body = f"/tmp/gh-post-{os.getpid()}.md"
    b64 = base64.b64encode(body_file.read_bytes()).decode()
    ship = run([LAPTOP_SSH, f"echo {b64} | base64 -d > {remote_body}"])
    if ship.returncode != 0:
        return (False, f"body transfer to laptop failed: {ship.stderr[-200:]}")
    remote_args = [a if a != str(body_file) else remote_body for a in args]
    r = run([LAPTOP_SSH, "python3 " + PAPERWORK + " " + " ".join(shlex.quote(a) for a in remote_args)])
    out = ((r.stdout or "") + (r.stderr or "")).strip()
    run([LAPTOP_SSH, f"rm -f {remote_body}"])
    return (r.returncode == 0, out)


def leg_app_comment(repo: str, number: int, body_file: Path) -> tuple[str, str]:
    ok, out = laptop_paperwork(
        ["comment", "--repo", repo, "--issue", str(number),
         "--body-file", str(body_file)],
        body_file,
    )
    if ok:
        m = URL_RE.search(out)
        url = m.group(0) if m else "(url in fleet-paperwork output)"
        print(f"posted (app: developing.today[bot]): {url}")
        return ("posted", url)
    return ("failed", out[-400:])


def leg_app_create(repo: str, title: str, body_file: Path, labels: list[str]) -> tuple[str, str]:
    args = ["create", "--repo", repo, "--title", title, "--body-file", str(body_file)]
    for lab in labels:
        args += ["--label", lab]
    ok, out = laptop_paperwork(args, body_file)
    if ok:
        m = URL_RE.search(out)
        url = m.group(0) if m else "(url in fleet-paperwork output)"
        print(f"posted (app: developing.today[bot]): {url}")
        return ("posted", url)
    return ("failed", out[-400:])


def next_ob_id(text: str) -> str:
    today = datetime.now(timezone.utc).strftime("%Y-%m-%d")
    n = 0
    for m in re.finditer(rf"### OB-{today}-(\d+)", text):
        n = max(n, int(m.group(1)))
    while True:
        n += 1
        ob = f"OB-{today}-{n:03d}"
        if f"### {ob} " not in text and f"### {ob}\n" not in text:
            return ob


def enqueue(kind: str, repo: str, body_file: Path, title: str | None,
            target: str | None, labels: list[str]) -> str:
    text = OUTBOX.read_text()
    digest = hashlib.sha256(body_file.read_bytes()).hexdigest()[:12]
    slug = re.sub(r"[^a-z0-9]+", "-", repo.lower()).strip("-")
    stamp = datetime.now(timezone.utc).strftime("%Y%m%d-%H%M%S")
    stored = HIDDEN / f"gh-post-{stamp}-{slug}-{digest}.md"
    # Dedupe: an identical prepared body already pending is the same action.
    pending = text.split("## Done")[0]
    for m in re.finditer(r"(?:body_file|text_file): hidden_files/(\S+)", pending):
        cand = HIDDEN / m.group(1)
        if cand.exists() and hashlib.sha256(cand.read_bytes()).hexdigest()[:12] == digest:
            em = re.search(r"### (OB-\S+) ·[^\n]*\n(?:[^\n]*\n)*?- (?:body_file|text_file): hidden_files/"
                           + re.escape(m.group(1)), pending)
            return f"{em.group(1) if em else 'existing entry'} (dedupe: identical body already pending)"
    stored.write_bytes(body_file.read_bytes())
    ob = next_ob_id(text)
    now = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
    lines = [f"### {ob} · {kind} · {repo}", "- status: prepared",
             f"- prepared_by: gh-post {now}"]
    if kind == "issue":
        lines.append(f"- title: {title}")
        lines.append(f"- body_file: hidden_files/{stored.name}")
        if labels:
            lines.append(f"- labels: {', '.join(labels)}")
        lines.append("- agent_note: standard")
    else:
        lines.append(f"- target: {target}")
        lines.append(f"- text_file: hidden_files/{stored.name}")
    lines += ["- attempts: 0", "- last_error: -",
              "- note: enqueued by gh-post after user + app routes failed "
              "(rate-limit path, code#6129)", ""]
    entry = "\n".join(lines)
    marker = "## Done"
    idx = text.find(marker)
    if idx == -1:
        die("outbox has no ## Done section marker; refusing to append blindly")
    OUTBOX.write_text(text[:idx] + entry + text[idx:])
    return ob


def main() -> int:
    ap = argparse.ArgumentParser(prog="gh-post", description=__doc__)
    sub = ap.add_subparsers(dest="cmd", required=True)
    pc = sub.add_parser("comment")
    pc.add_argument("--repo", required=True)
    pc.add_argument("--issue", type=int)
    pc.add_argument("--pr", type=int)
    pc.add_argument("--body-file", required=True)
    pi = sub.add_parser("create")
    pi.add_argument("--repo", required=True)
    pi.add_argument("--title", required=True)
    pi.add_argument("--body-file", required=True)
    pi.add_argument("--label", action="append", default=[])
    pn = sub.add_parser("note")
    pn.add_argument("--repo", required=True)
    pn.add_argument("--issue", type=int)
    pn.add_argument("--pr", type=int)
    pn.add_argument("--body-file", required=True)
    pn.add_argument("--note-key")
    pk = sub.add_parser("check")
    pk.add_argument("--body-file", required=True)
    args = ap.parse_args()

    body_file = Path(args.body_file)
    if not body_file.exists():
        die(f"body file not found: {body_file}")
    if args.cmd == "check":
        findings = scan_body(body_file.read_text(errors="replace"))
        if findings:
            print("BLOCKED: credential-shaped text found:")
            for f in findings:
                print(f"  - {f}")
            return 4
        print("clean: no credential-shaped text found")
        return 0
    enforce_scan(body_file)
    skip_user = os.environ.get("GH_POST_SKIP_USER") == "1"
    skip_app = os.environ.get("GH_POST_SKIP_APP") == "1"

    if args.cmd == "note":
        number = args.issue or args.pr
        if not number:
            die("note needs --issue N or --pr N")
        key = args.note_key or os.environ.get("FLEET_JOB") or "gh-post"
        if not re.fullmatch(r"[A-Za-z0-9_.-]+", key):
            die(f"bad note key {key!r} (want [A-Za-z0-9_.-]+)", 2)
        kind = "pr_comment" if args.pr else "issue_comment"
        th, circuit_until, holder = throttle_acquire(kind, args.repo)
        if circuit_until:
            die(f"content-throttle circuit open until {circuit_until}; "
                "park the task and resume after that time (hatch#13)", 7)
        existing = find_live_note(args.repo, number, key)
        raw = body_file.read_text(errors="replace")
        if existing is None:
            # First note on this target: create it through the ledger's
            # verify-by-read path (it reserves/finalises its own row).
            if content_ledger is None:
                die(f"content-ledger module unavailable "
                    f"({_LEDGER_IMPORT_ERROR})", 5)
            marked = raw.rstrip("\n") + f"\n\n{note_marker(key)}\n"
            try:
                res = content_ledger.create_comment(
                    args.repo, number, marked, pr=bool(args.pr),
                    job=os.environ.get("FLEET_JOB", "gh-post"))
            except content_ledger.CreateFailed as e:
                die(f"live-note create failed (ledger row "
                    f"{e.reservation_id}): {e.detail}")
            except content_ledger.LedgerError as e:
                die(f"content-ledger failure: {e}", 5)
            throttle_note_user_outcome(th, "posted")
            holder["outcome"] = "created"
            print(f"posted (live note): {res.ref}")
            return 0
        # Later notes: edit the same comment in place. The edit is a
        # content-generating call, so it is ledgered like a creation
        # (design open question 2: assume PATCH counts).
        led, row, nonce = ledger_reserve(kind, args.repo)
        body = (raw.rstrip("\n") + f"\n\n{note_marker(key)}\n"
                f"<!-- fleet-nonce:{nonce} -->\n")
        fd, tmp = tempfile.mkstemp(prefix="gh-post-note-", suffix=".json")
        with os.fdopen(fd, "w") as f:
            json.dump({"body": body}, f)
        atexit.register(lambda: os.path.exists(tmp) and os.unlink(tmp))
        r = run(["gh", "api", "--method", "PATCH",
                 f"repos/{args.repo}/issues/comments/{existing['id']}",
                 "--input", tmp])
        if r.returncode != 0:
            detail = ((r.stderr or "") + (r.stdout or "")).strip()[-500:]
            if is_limit(detail):
                throttle_note_user_outcome(th, "limited")
            ledger_finalize(led, row, "failed",
                            detail=f"live-note edit failed: {detail}")
            die(f"live-note edit failed: {detail}")
        got = run(["gh", "api",
                   f"repos/{args.repo}/issues/comments/{existing['id']}",
                   "--jq", ".body"])
        if got.returncode != 0 or got.stdout.rstrip("\n") != body.rstrip("\n"):
            ledger_finalize(led, row, "failed",
                            detail="live-note edit readback mismatch")
            die("live-note edit could not be verified by read")
        throttle_note_user_outcome(th, "posted")
        ledger_finalize(
            led, row, "created", ref=existing.get("html_url"),
            detail=f"live-note edit of comment {existing['id']} "
                   "(hatch#13 item 5)")
        holder["outcome"] = "created"
        print(f"edited (live note): {existing.get('html_url')}")
        return 0

    if args.cmd == "comment":
        number = args.issue or args.pr
        if not number:
            die("comment needs --issue N or --pr N")
        th, circuit_until, holder = throttle_acquire(
            "pr_comment" if args.pr else "issue_comment", args.repo)
        led, row, nonce = ledger_reserve(
            "pr_comment" if args.pr else "issue_comment", args.repo)
        body_file = effective_body_file(body_file, nonce)
        if circuit_until:
            outcome, detail = "limited", (
                f"content-throttle circuit open until {circuit_until}; "
                "user leg not attempted (hatch#13)")
        elif skip_user:
            outcome, detail = "limited", "GH_POST_SKIP_USER test hook"
        else:
            outcome, detail = leg_user_comment(args.repo, number, bool(args.pr), body_file)
        if not skip_user and not circuit_until:
            throttle_note_user_outcome(th, outcome)
        if outcome == "posted":
            # The user leg's own readback verified the exact posted body
            # (nonce included) — that read is the confirming read.
            ledger_finalize(led, row, "created", ref=detail)
            holder["outcome"] = "created"
            return 0
        if outcome == "error":
            ledger_finalize(led, row, "failed", detail=detail)
            die(f"user leg failed (not rate-limit class): {detail}")
        print(f"gh-post: user route rate-limited; trying App route. ({detail[:120]})",
              file=sys.stderr)
        if skip_app:
            outcome2, detail2 = "failed", "GH_POST_SKIP_APP test hook"
        else:
            outcome2, detail2 = leg_app_comment(args.repo, number, body_file)
        if outcome2 == "posted":
            # fleet-paperwork verifies by readback itself (see header).
            ledger_finalize(
                led, row, "created",
                ref=detail2 if detail2.startswith("http") else None,
                detail=None if detail2.startswith("http")
                else "posted via App leg; URL not in fleet-paperwork output",
                actor="developing.today[bot]")
            holder["outcome"] = "created"
            return 0
        print(f"gh-post: App route failed too; enqueueing in the action outbox. ({detail2[:200]})",
              file=sys.stderr)
        try:
            ob = enqueue("comment", args.repo, body_file, None,
                         f"{'pr' if args.pr else 'issue'} #{number}", [])
        except SystemExit:
            ledger_finalize(led, row, "failed",
                            detail="outbox enqueue failed after both legs")
            raise
        ledger_finalize(
            led, row, "failed",
            detail=f"user+app legs rate-limited; queued to outbox {ob}; "
                   "creation not yet performed"
                   + (f"; user leg: {detail}" if circuit_until else ""))
        print(f"QUEUED {ob}")
        return 3

    # create
    th, circuit_until, holder = throttle_acquire("issue", args.repo)
    led, row, nonce = ledger_reserve("issue", args.repo)
    body_file = effective_body_file(body_file, nonce)
    if circuit_until:
        outcome, detail = "limited", (
            f"content-throttle circuit open until {circuit_until}; "
            "user leg not attempted (hatch#13)")
    elif skip_user:
        outcome, detail = "limited", "GH_POST_SKIP_USER test hook"
    else:
        outcome, detail = leg_user_create(args.repo, args.title, body_file, args.label)
    if not skip_user and not circuit_until:
        throttle_note_user_outcome(th, outcome)
    if outcome == "posted":
        # The create leg trusts the returned URL; the ledger's standard
        # is stricter — confirm by read before recording success.
        verified = content_ledger.confirm_created(
            args.repo, "issue", detail, nonce)
        if verified:
            ledger_finalize(led, row, verified, ref=detail)
            holder["outcome"] = "created"
            return 0
        ledger_finalize(
            led, row, "failed",
            detail=f"user leg returned {detail} but no read confirms "
                   "the object (readback mismatch)")
        die(f"user leg returned {detail} but verify-by-read could not "
            "confirm the object; recorded as failed in the content ledger")
    if outcome == "error":
        ledger_finalize(led, row, "failed", detail=detail)
        die(f"user leg failed (not rate-limit class): {detail}")
    print(f"gh-post: user route rate-limited; trying App route. ({detail[:120]})",
          file=sys.stderr)
    if skip_app:
        outcome2, detail2 = "failed", "GH_POST_SKIP_APP test hook"
    else:
        outcome2, detail2 = leg_app_create(args.repo, args.title, body_file, args.label)
    if outcome2 == "posted":
        ledger_finalize(
            led, row, "created",
            ref=detail2 if detail2.startswith("http") else None,
            detail=None if detail2.startswith("http")
            else "posted via App leg; URL not in fleet-paperwork output",
            actor="developing.today[bot]")
        holder["outcome"] = "created"
        return 0
    print(f"gh-post: App route failed too; enqueueing in the action outbox. ({detail2[:200]})",
          file=sys.stderr)
    try:
        ob = enqueue("issue", args.repo, body_file, args.title, None, args.label)
    except SystemExit:
        ledger_finalize(led, row, "failed",
                        detail="outbox enqueue failed after both legs")
        raise
    ledger_finalize(
        led, row, "failed",
        detail=f"user+app legs rate-limited; queued to outbox {ob}; "
               "creation not yet performed"
               + (f"; user leg: {detail}" if circuit_until else ""))
    print(f"QUEUED {ob}")
    return 3


if __name__ == "__main__":
    sys.exit(main())
