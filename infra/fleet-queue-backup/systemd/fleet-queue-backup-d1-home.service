[Unit]
Description=fleet-queue-backup: export the fleet-queue-backup D1 database to its Turso home (mesh class D, #13458)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# The export reads the whole D1 copy through the D1 query API before
# the staged import into the home begins; the bound matches the
# Turso -> D1 export service's measured-cycle headroom (#8584).
TimeoutStartSec=2h
ExecStartPre=/usr/bin/env bash __FQ_DIR__/systemd/update-checkout.sh
ExecStart=/usr/bin/env bash __FQ_DIR__/systemd/run-d1-home-export.sh
