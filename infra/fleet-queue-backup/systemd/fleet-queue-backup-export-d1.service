[Unit]
Description=fleet-queue-backup: export the live D1 fleet-queue plane to its D1 backup copy (CF-3, #14943)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# The D1 -> D1 export reads the whole live plane through the D1 query
# API before the import begins; the bound mirrors the Turso leg's
# measured cycle with headroom for import + verify.
TimeoutStartSec=2h
ExecStartPre=/usr/bin/env bash __FQ_DIR__/systemd/update-checkout.sh
ExecStart=/usr/bin/env bash __FQ_DIR__/systemd/run-export-d1.sh
