// RE-ENABLED 2026-10-30 (Drew, direct order): this provider — the
// muse program's OAuth session via muse-proxy — is now the ONLY
// working door into the single Meta plan (the Muse API High Usage
// plan). Verified 2026-10-30: the direct "meta" provider is dead by
// Meta's design — the plan API key returns 403
// client_attestation_denied from any non-Muse-Code client, and the
// OAuth access_token returns 401 invalid_api_key at
// /chat/completions; only the genuine muse program passes
// attestation. (The 2026-10-25 disable assumed the direct key door
// worked; it does not.) The routes seat muse/* leaves at the
// positions and weights the meta/* leaves held. The proxy strips
// META_API_KEY so calls take the OAuth plan route, not the PAYG key
// route. This is NOT the assistant Muse's Power subscription and
// NOT a separate pool — same one Meta pool, working door.
     "muse": {
       "npm": "@ai-sdk/openai-compatible",
       "name": "Muse (CLI via muse-proxy)",
       "options": {
         "baseURL": "http://127.0.0.1:{env:MUSE_PROXY_PORT:-18747}/v1",
         "apiKey": "muse-local"
       },
       "models": {
         "muse-spark-1.3": {
           "name": "Muse Spark 1.3 (muse)"
         },
         "muse-spark-1.3-contributor": {
           "name": "Muse Spark 1.3 Contributor (muse)"
         },
         "muse-wonder-1.0": {
           "name": "Muse Wonder 1.0 (muse)"
         },
         "muse-spark-1.3-low": {
           "name": "Muse Spark 1.3 Low (muse)"
         },
         "muse-wonder-1.0-low": {
           "name": "Muse Wonder 1.0 Low (muse)"
         }
       }
     },

// muse-direct (2026-10-30, #2753): the Responses-native door into the
// SAME single Meta pool (the Muse API High Usage plan) — not a
// separate pool, and not the assistant Muse's subscription. It fronts
// muse-proxy's DIRECT mode: the proxy exchanges the Muse CLI's OAuth
// account token at /muse-code/key for the plan's minted key and speaks
// the Responses API, the route that answers that key with bare
// Authorization (the chat-completions route is the one returning
// client_attestation_denied to non-CLI clients). This provider uses
// @ai-sdk/openai so OpenCode speaks Responses to the proxy's
// /v1/responses passthrough, which swaps in the minted key; the "muse"
// provider above (chat route into the same proxy) is untouched. The
// apiKey below is the local placeholder the proxy ignores — the real
// key never leaves the proxy and no auth.json entry is needed. A call
// costs ~10 input tokens through this door vs ~26k through the CLI
// harness. The provider's models are the contributor variants — the
// ids the routes seat — with the effort variants the "meta" block
// defines for its contributor models.
     "muse-direct": {
       "npm": "@ai-sdk/openai",
       "name": "Meta Muse Direct (proxy)",
       "options": {
         "baseURL": "http://127.0.0.1:{env:MUSE_PROXY_PORT:-18747}/v1",
         "apiKey": "muse-local"
       },
       "models": {
         "muse-spark-1.3-contributor": {
           "name": "Muse Spark 1.3 Contributor (muse-direct)",
           "variants": {
             "minimal": { "options": { "reasoning_effort": "minimal" } },
             "low": { "options": { "reasoning_effort": "low" } },
             "medium": { "options": { "reasoning_effort": "medium" } },
             "high": { "options": { "reasoning_effort": "high" } },
             "xhigh": { "options": { "reasoning_effort": "xhigh" } },
             "max": { "options": { "reasoning_effort": "max" } }
           }
         },
         "muse-wonder-1.0-contributor": {
           "name": "Muse Wonder 1.0 Contributor (muse-direct)",
           "variants": {
             "minimal": { "options": { "reasoning_effort": "minimal" } },
             "low": { "options": { "reasoning_effort": "low" } },
             "medium": { "options": { "reasoning_effort": "medium" } },
             "high": { "options": { "reasoning_effort": "high" } },
             "xhigh": { "options": { "reasoning_effort": "xhigh" } },
             "max": { "options": { "reasoning_effort": "max" } }
           }
         }
       }
     },
