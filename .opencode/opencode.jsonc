{
  // PROVIDER ALIGNMENT (2026-10-24, Drew): both machines carry the same
  // providers; unneeded ones are disabled here, identically on both.
  // - Token-based Google/Gemini paths are OFF. EARMARK: when a token-based
  //   Gemini path is wanted one day, use the "google" provider below — it is
  //   THE token path (Gemini API key; working muse-sandbox free-tier key is
  //   in the credential store as "Google API (muse-sandbox)").
  // - THE Antigravity provider is "antigravity-ls" (warm language-server
  //   route). "antigravity-agy" (CLI spawn route) sat disabled as the
  //   fallback until 2026-10-28, when Drew re-enabled it for one seated
  //   purpose: the agy CLI is a door that serves Gemini 4 Argon, so
  //   argon-plan seats antigravity-agy/gemini-4-argon. Its other models
  //   stay route-gated (seated nowhere).
  // - 2026-10-30 (Drew): the Antigravity doors consolidated on
  //   "antigravity-direct" — a proxy that speaks the agy CLI's own wire
  //   protocol directly (keyring OAuth credential, the CLI's refresh
  //   client, its v1internal envelope to daily-cloudcode-pa) with no
  //   spawned CLI and no spawned language server. "antigravity-ls" and
  //   "antigravity-agy" are in disabled_providers below and their proxy
  //   services are retired in home/common/default.nix; their definitions
  //   stay FULL below per the switchboard rule. The Gemini seats moved
  //   to antigravity-direct (gemini-flash-plan, argon-plan). The Claude
  //   seats in sonnet-plan and opus-plan still name antigravity-ls:
  //   they are inert while the provider is disabled, until they are
  //   re-pointed or the door is restored. Undo: delete both ids from
  //   disabled_providers, restore the two proxy units, re-point seats.
  //   2026-10-30 (Drew, later the same day): "only the direct —
  //   replace all others": the sonnet-plan and opus-plan Claude seats
  //   are re-pointed to antigravity-direct as well; no route leaf
  //   names antigravity-ls or antigravity-agy anymore.
  // - 2026-11-04 (opencode#1414): the antigravity-direct block below no
  //   longer names the :18751 proxy — it resolves to the fork native
  //   antigravity provider (opencode#1457). Same id, same wire; the
  //   door unit and bin/antigravity-direct.mjs retire once :18751
  //   shows a zero-traffic window.
  // - "claude-code" was TEMPORARILY disabled (2026-10-27, Drew; RE-ENABLED 2026-11-06, Drew - see the dated note above disabled_providers): the Claude
  //   plan is on the FREE tier for now and the API may be down. The setup
  //   itself was confirmed working at pause time — the proxy (:18749)
  //   was live and served claude-haiku-5-5 (verified 2026-10-27) — and
  //   the pause began as config-level only. That changed on 2026-11-05:
  //   the provider block below was repointed from the proxy to the
  //   fork's native claude-code provider (code#6117, opencode#1749),
  //   and on 2026-11-06 the proxy itself (bin/claude-code-proxy.mjs,
  //   its systemd unit and :18749) was removed in the proxy-infra
  //   decommission. Claude MODELS via other plans (antigravity-ls,
  //   cline-pass, opendesign leaves in haiku/sonnet/opus-plan) are NOT the
  //   Claude plan and are unaffected. To re-enable: delete "claude-code"
  //   from disabled_providers and restore the "default" below.
  // To re-enable a provider: delete its id from disabled_providers.
  // That list is the PROVIDER SWITCHBOARD — see the comment block directly
  // above it for the full mechanism.
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  // ==========================================================================
  // PROVIDER SWITCHBOARD — the ONE place providers are turned on and off.
  //
  // A provider is ON unless its id appears in disabled_providers below.
  // To turn a provider OFF: add its id to the list. To turn it back ON:
  // delete its id from the list. That one-line edit is the whole job —
  // nothing else in this file needs to change.
  //
  // Every fleet provider keeps its FULL definition (models, options) in the
  // "provider" block below at all times, disabled or not, so re-enabling
  // never requires reconstructing config. The only step beyond the flip is
  // the provider's own sign-in / credential, which lives outside this file.
  //
  // Providers with NO definition below (google-vertex, nvidia, vercel,
  // huggingface, opencode, github-copilot) are opencode built-ins: the app
  // ships their catalogs, so the list alone switches them — no definition
  // is missing.
  //
  // Route pools need no edits either: a pool leaf pointing at an OFF
  // provider simply yields nothing until that provider is flipped back on
  // (the pools below already ship that way — haiku-plan seats claude-code
  // while it is off).
  //
  // WORKED EXAMPLE — Claude (resolved 2026-11-06, when claude-code
  // left the list): "claude-code" sat in the list because the Claude
  // plan was on the free tier (see the header note). The day it
  // comes back, delete the "claude-code" line from the list and Claude is
  // live: its definition, model catalog, and haiku-plan seat are already in
  // place, and every tier that consumes haiku-plan (scout, workhorse,
  // speed, luna-haiku-100k) picks it up on its own. The only remaining step
  // is the claude.ai sign-in. (Restoring "default" to
  // claude-code/claude-haiku-5-5 is an optional preference, NOT part of
  // enabling — the workhorse default works either way.)
  //
  // REVERSED 2026-10-30 (Drew, direct order): "muse" leaves this list.
  // The direct "meta" door is dead by Meta's design (attestation —
  // see the note at the "muse" provider), so muse-proxy is now the
  // only working door into the same single Meta pool, and the
  // routes seat muse/* leaves where the meta/* leaves sat, at the
  // same weights and positions.
  //
  // KNOWN EXCEPTION -- RESOLVED 2026-11-03 (Drew, direct order): the
  // design-code / code-design / open-design proxy blocks that stayed
  // commented out here as preserved legacy were DELETED, together with
  // the design-code door's persona routes. The only design provider in
  // this config is "opendesign" (on).
  // ==========================================================================
  // 2026-10-30 (route audit): "deepseek" joins the list below. Its
  // definition is the DeepSeek OFFICIAL API — a pay-as-you-go funds
  // door, not a plan pool — and no route seats it (DeepSeek models
  // reach the tiers through the plan doors: OpenCode Go, ClinePass,
  // OpenDesign, Command Code). It has taken no traffic since
  // 2026-10-25. Per the switchboard rule this flip is the whole job;
  // its full definition stays in the provider block, and deleting
  // the line re-enables it if the direct door is ever wanted.
  // 2026-11-05 (Drew, direct order — supersedes the 2026-10-30 note
  // above for this seat): "deepseek" LEAVES the list. The official-API
  // door is re-enabled to serve one seat: deepseek/deepseek-flash
  // ("1017") joins the deepseek-flash-plan route as its API leg under a
  // weighted 2:1 plan:API split (see that route). The NEVER-FUNDS
  // default stands for every other route; this seat is Drew's named
  // exception, sized at the minority share of one pool.
  // CORRECTED 2026-11-05 (Drew, later direct order — supersedes the
  // paragraph directly above): "no don't re enable deepseek." The
  // provider RETURNS to the list below. Its deepseek-flash-plan seat
  // is a named SLOT, not an enablement exception: it stays in the
  // pool in LAST position, and while the provider is disabled the
  // seat contributes no leaf and can never be drawn (disabled
  // providers are absent from the catalog, so route expansion drops
  // the target entirely — it appears in neither the candidate list
  // nor the exclusion list of the route's decision records, unlike
  // quota/cooldown exclusions, which are recorded with reasons; the
  // quota-block mechanism is a separate key and is untouched by
  // this). The NEVER-FUNDS default stands with NO exception: the
  // seat exists so that re-enabling, if Drew ever orders it, is the
  // usual one-line flip. The DEEPSEEK_API_KEY plumbing
  // (nixos/agent-auth + home/common materializer) is KEPT for the
  // same reason — slotted and ready, just disabled.
  // UPDATE 2026-11-06 (#6414): the seat itself was later removed
  // from deepseek-flash-plan — the metered-provider guard rejects a
  // metered selection even while disabled, and the seated target
  // failed main's bin-tests CI. The provider, its definition, and
  // the key plumbing above are unchanged; see the REMOVED note on
  // the route for the two-step re-enable.
  // 2026-10-30 (Drew, direct order): "meta" joins the list below.
  // The direct api.meta.ai door is dead by Meta's design — the plan
  // API key returns 403 client_attestation_denied from any
  // non-Muse-Code client and the OAuth token 401s (see the note at
  // the "muse" provider). The routes no longer seat meta/* leaves
  // (#2635 moved them to muse/* via muse-proxy, the working door).
  // Per the switchboard rule the full definition stays in the
  // provider block; deleting this line re-enables it if Meta ever
  // serves this client again.
  // 2026-10-30 (Drew, direct order — supersedes the two notes above):
  // "muse" joins the list too, and "muse-direct" replaces BOTH older
  // Meta doors. muse-proxy's direct mode (#2753) exchanges the Muse
  // CLI account token for the plan's minted key and speaks the
  // Responses API — the route that accepts that key — so the fleet no
  // longer needs the CLI-harness door ("muse") or the attestation-dead
  // direct door ("meta"). muse-direct is the ONLY enabled Meta-family
  // provider; both older definitions stay FULL below per the
  // switchboard rule, and the routes' Meta leaves were retargeted to
  // muse-direct contributor models in the same pass.
  // 2026-10-31 (Drew, direct order): "commandcode" joins the list.
  // Its credits are exhausted (about ten cents left, expired the morning
  // of 2026-10-31) and an empty pool must not run: sessions were
  // still being routed onto its leaves (deepseek-flash-plan,
  // spark-plan, sol-plan, beam-plan, mimo-flash-plan, scout) and
  // retry-looping on "insufficient credits". Per the switchboard
  // rule the definition and every seat stay in place; deleting
  // this line re-enables Command Code if it is ever refilled.
  // 2026-11-06: "commandcode" LEAVES the list. The blocker named in the
  // 2026-10-31 note was twofold — an empty balance, and a router that kept
  // retry-looping its leaves. The router half is fixed by the provider-
  // availability system (opencode#1828): an exhausted-balance provider now
  // classifies as quota/balance, benches on its first failure, and costs a
  // session nothing while stopped; its seats stay seated and it rejoins
  // automatically when the balance shows a measured increase. Evidence:
  // the #1828 harness scenarios (seamlessness + measured-increase release).
  // 2026-11-01 (Drew, direct order): "muse-direct" joins the list.
  // The Meta pool is quota-exhausted until 2026-11-02T00:00:00Z and
  // sessions dealt its muse-spark leg die on the 429 with no local
  // fall (code#3325; 46 dead by 06:03 CST, incl. two full waves).
  // Drew: disable the provider, do NOT change the routes - every
  // seat and definition stays in place per the switchboard rule.
  // To re-enable after the pool resets: delete this one line.
  // REVERSED 2026-11-02 (Drew, direct order): "muse-direct" leaves
  // the list. The Meta pool reset at 2026-11-02T00:00:00Z and reads
  // fresh 0% with 100 pts headroom; the door is back in service.
  // 2026-11-06 (Drew, direct order): "claude-code" LEAVES the list
  // below - the Claude plan is back (Claude Max enabled on the
  // account) and the provider is re-enabled by this one-line flip,
  // per the switchboard rule. Its seats were already in place:
  // haiku-plan (leads), sonnet-plan (leads; feeds specialist head
  // and workhorse-primary), opus-plan (leads; feeds summit head).
  // No route edits: Drew ordered no new seats in speed/workhorse,
  // and the seats there (via haiku-plan / sonnet-plan) are the ones
  // already shipped. NOTE: re-enabling makes claude-code the live
  // lead of haiku-plan again, ahead of opendesign - the
  // haiku-plan re-enable lead-order question (ledger item
  // haiku-plan-claude-code-reenable-order, issue #1132) is still
  // open; if Drew rules OpenDesign keeps the lead, that is a
  // one-line targets reorder in haiku-plan, not a switchboard
  // change. Credential: ~/.claude/.credentials.json (native
  // provider reads it in place); live-probed at enable time.
  "disabled_providers": [
    "google",
    "google-vertex",
    "cloudflare-ai-gateway",
    "groq",
    "nvidia",
    "vercel",
    "huggingface",
    "opencode",
    "github-copilot",
    "openrouter",
    "cloudflare-workers-ai",
    "meta",
    "deepseek"
  ],
  // 2026-11-03 (Drew): muse, antigravity-ls, antigravity-agy, code-design,
  // design-code, cloudflare-gateway and chatgpt left this list together with
  // their provider definitions -- retired and deleted, not just disabled.
  // google, google-vertex, cloudflare-ai-gateway, cloudflare-workers-ai and
  // github-copilot had their definitions deleted too, but their entries STAY
  // as tombstones: the provider catalog auto-activates those five ids unless
  // they are listed here (verified live 2026-11-03 -- with the entries removed
  // all five reappeared in the running server within minutes). The entries are
  // the only trace of them left; there are no definitions to flip back on.
  // openai-codex followed on 2026-11-03: its ten route legs were re-seated
  // onto openai-plan (the ChatGPT provider route) and the definition was
  // deleted with the rest. It is a custom id with no catalog entry, so --
  // unlike the five tombstones above -- no entry stays for it here.
  // "open-design" (the design-code door shell) followed on 2026-11-03 too:
  // its commented-out definition and the door's 11 persona routes were
  // deleted on Drew's direct order, and -- a custom id like openai-codex,
  // not a catalog id -- no entry stays for it here either.
  // Default was "claude-code/claude-haiku-5-5" until the 2026-10-27 Claude
  // pause (see the header note). Workhorse is the fleet's standard tier and
  // what agent configs already default to; restoring the Haiku default
  // when claude-code is re-enabled is an optional preference, not part of
  // enabling it (see the PROVIDER SWITCHBOARD above).
  // claude-code is re-enabled.
  // The v2 default-model key is "model" (config normalize.ts reads only
  // input.model; the "default" key above is not consumed by the 2.x schema
  // and the server otherwise falls back to its first-available model —
  // which was commandcode/gpt-5.6-terra, failing over to gpt-6-luna.
  // Verified 2026-10-29 against /api/model/default. Drew’s ruling: a
  // session with no model chosen resolves to the workhorse route.
  "model": "opencode-route/workhorse",
  // Small-model slot (2026-10-29, Drew): the route `speed`, never a direct
  // provider leaf. OpenChamber’s small-model resolver reads this key (or
  // the title agent’s model) when no settings override applies; a capable
  // route is deliberate — compaction and summaries have to read a lot, so
  // the slot is a real tier, not the cheapest model on any plan.
  "small_model": "opencode-route/speed",
  // Messaging embeddings OFF (2026-10-29, Drew): the messaging.embedding
  // tier defaults to a local Qwen3-Embedding llama-server that autostarts
  // with every OpenCode process (standing server + OpenChamber managed
  // instance). Tier off disables it; semantic message search degrades to
  // the fuzzy FTS fallback. Re-enable by removing this key.
  "messaging": {
    "embedding": "off"
  },
  // Provider catalogs for antigravity-direct, openai-codex, google, openai and
  // cloudflare-gateway are sync-owned: their "models" live in the runtime overlay
  // (~/.local/state/opencode/opencode-runtime.jsonc), layered over this file via
  // OPENCODE_CONFIG — see code#4544. Everything else here is deliberate config.
  "provider": {
    "claude-code": {
      // 2026-11-05 (code#6117, opencode#1749): repointed from the CLI proxy
      // (:18749, @ai-sdk/openai-compatible) to the in-fork native claude-code
      // provider - same provider id, native wire emulation of the Claude Code
      // CLI, credential read in place from ~/.claude/.credentials.json; no
      // baseURL/apiKey (the provider owns auth). STILL in disabled_providers:
      // re-enabling stays a separate deliberate step.
      "npm": "@opencode/ai/providers/claude-code",
      "name": "Claude Code (native wire emulation)",
      "models": {
        "claude-haiku-5-5": {
          "name": "Haiku 5.5 (Claude Code)",
          "variants": {
            "low": {
              "options": {
                "thinking": {
                  "type": "enabled",
                  "budget_tokens": 4096
                }
              }
            },
            "medium": {
              "options": {
                "thinking": {
                  "type": "enabled",
                  "budget_tokens": 8192
                }
              }
            },
            "high": {
              "options": {
                "thinking": {
                  "type": "enabled",
                  "budget_tokens": 16384
                }
              }
            },
            "xhigh": {
              "options": {
                "thinking": {
                  "type": "enabled",
                  "budget_tokens": 32768
                }
              }
            },
            "max": {
              "options": {
                "thinking": {
                  "type": "enabled",
                  "budget_tokens": 65536
                }
              }
            }
          },
          "limit": {
            "context": 1000000,
            "output": 64000
          }
        },
        "claude-sonnet-5-5": {
          "name": "Sonnet 5.5 (Claude Code)",
          "variants": {
            "low": {
              "options": {
                "thinking": {
                  "type": "enabled",
                  "budget_tokens": 4096
                }
              }
            },
            "medium": {
              "options": {
                "thinking": {
                  "type": "enabled",
                  "budget_tokens": 8192
                }
              }
            },
            "high": {
              "options": {
                "thinking": {
                  "type": "enabled",
                  "budget_tokens": 16384
                }
              }
            },
            "xhigh": {
              "options": {
                "thinking": {
                  "type": "enabled",
                  "budget_tokens": 32768
                }
              }
            },
            "max": {
              "options": {
                "thinking": {
                  "type": "enabled",
                  "budget_tokens": 65536
                }
              }
            }
          },
          "limit": {
            "context": 1000000,
            "output": 64000
          }
        },
        "claude-opus-5-5": {
          "name": "Opus 5.5 (Claude Code)",
          "variants": {
            "low": {
              "options": {
                "thinking": {
                  "type": "enabled",
                  "budget_tokens": 4096
                }
              }
            },
            "medium": {
              "options": {
                "thinking": {
                  "type": "enabled",
                  "budget_tokens": 8192
                }
              }
            },
            "high": {
              "options": {
                "thinking": {
                  "type": "enabled",
                  "budget_tokens": 16384
                }
              }
            },
            "xhigh": {
              "options": {
                "thinking": {
                  "type": "enabled",
                  "budget_tokens": 32768
                }
              }
            },
            "max": {
              "options": {
                "thinking": {
                  "type": "enabled",
                  "budget_tokens": 65536
                }
              }
            }
          },
          "limit": {
            "context": 1000000,
            "output": 64000
          }
        }
      }
    },
    "antigravity-direct": {
      "npm": "@opencode/ai/providers/antigravity",
      "name": "Antigravity Direct (CLI wire clone)"
      // 2026-11-04 (opencode#1414): repointed from the :18751 door to
      // the native in-fork provider (opencode#1457) — same provider id,
      // same v1internal wire protocol, keyring credential read in place
      // by the server; no baseURL/apiKey (the provider owns auth). The
      // door unit + bin/antigravity-direct.mjs retire after a
      // zero-traffic window on :18751.
      // "models": maintained by sync-models in the runtime overlay (~/.local/state/opencode/opencode-runtime.jsonc) — see code#4544.
    },
    "mistral": {
      "npm": "@opencode/ai/providers/mistral",
      "name": "Mistral API (drewrypope)"
      // Credential: the enrolled server credential (integration
      // "mistral", Bitwarden mistral.api-key) — the only source.
      // MISTRAL_API_KEY is deliberately NOT materialized into the
      // server environment: vibe-direct's env-first resolution would
      // spend this API-budget key (see home/common, opencode#1653).
      // "models": maintained by sync-models in the runtime overlay (~/.local/state/opencode/opencode-runtime.jsonc) — see code#4544.
    },
    "vibe-direct": {
      "npm": "@opencode/ai/providers/vibe",
      "name": "Mistral Vibe Direct (native wire clone)",
      // 2026-11-04 (opencode#1653, PR #1661): native in-fork emulation of
      // the mistral-vibe binary — same Mistral wire, Vibe's presets and
      // the attribution stamp (metadata.call_source "vibe_code"; billing
      // follows the KEY, not the stamp — see the credential note).
      // No vibe subprocess.
      // Credential: vibe-auth resolution mirrors the binary (config ->
      // env -> ~/.vibe/.env -> keyring) and the server env must NOT
      // carry MISTRAL_API_KEY: that key is the API-budget key and
      // Mistral meters per key, so with the env slot empty vibe-direct
      // falls through to the keyring "ai.mistral.vibe" sign-in key —
      // the Vibe plan key.
      // Models are declared HERE: models.dev has no vibe entry, so
      // sync-models cannot maintain this catalog. The entries are the
      // preset ids + names from Vibe's own catalog (opencode#1653).
      // A model "limit" here must carry "output" alongside
      // "context": the v1 provider schema requires both, and an
      // entry that fails schema decode is dropped WHOLE at config
      // normalization — a context-only limit on the default model
      // is exactly what kept vibe-direct out of the provider catalog
      // until code#5934 (2026-11-04→05, opencode#1146). The default
      // model's limit below restores the binary-verified context
      // (262144, opencode#1661's preset); its "output" is the fork's
      // config-model default (32000), NOT a binary-verified figure.
      // The other models declare no limit and take that same
      // default (200000/32000) until someone verifies theirs.
      "models": {
        "mistral-vibe-cli-latest": {
          "name": "Mistral Medium 3.5",
          "limit": {
            "context": 262144,
            "output": 32000
          }
        },
        "mistral-medium-latest": {
          "name": "Mistral Medium"
        },
        "mistral-large-latest": {
          "name": "Mistral Large"
        },
        "mistral-small-latest": {
          "name": "Mistral Small",
          // Variants declared 2026-11-05: the models.dev catalog
          // attests none/high (reasoning effort) for this model id on
          // the Mistral wire this provider clones — the same variants
          // the "mistral" provider's catalog entry carries. Declaring
          // them is load-bearing, not cosmetic: a provider-route
          // group's variant set is the intersection of its legs'
          // producible variants, so an empty list here emptied
          // mistral-plan's variant set entirely — and because a
          // route's offered variants are likewise an intersection
          // across its targets, seating mistral-plan in
          // deepseek-flash-plan collapsed that pool's variant set and
          // broke every pinned-variant session on it (Variant
          // unavailable: low/high) until these were declared.
          "variants": {
            "none": {
              "options": {
                "reasoning_effort": "none"
              }
            },
            "high": {
              "options": {
                "reasoning_effort": "high"
              }
            }
          }
        },
        "codestral-latest": {
          "name": "Codestral"
        },
        "ministral-14b-latest": {
          "name": "Ministral 14B"
        },
        "ministral-8b-latest": {
          "name": "Ministral 8B"
        },
        "ministral-3b-latest": {
          "name": "Ministral 3B"
        }
      }
    },
    // "openai": model catalog maintained by sync-models in the runtime overlay (~/.local/state/opencode/opencode-runtime.jsonc) — see code#4544.
    // "openai-codex": retired 2026-11-03 -- definition deleted after its
    // route legs were re-seated onto openai-plan (see the note at
    // disabled_providers). The codex door program (:18744) was retired
    // 2026-11-06 in the proxy-infra decommission, completing the
    // #1154 cutover.
    // "open-design" (the design-code door shell, :18746): the commented-out
    // proxy block preserved here since 2026-10-25 was DELETED 2026-11-03
    // (Drew, direct order) together with the door's persona routes below.
    // The only design provider in this config is "opendesign" (further down).
    "openai.alternate": {
      "instanceOf": "openai",
      "name": "OpenAI Alternate (Student - popesdrew)"
    },
    "openai.main": {
      "instanceOf": "openai",
      "name": "OpenAI Main (drewrypope)"
    },
    "opendesign": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Open Design",
      "options": {
        "baseURL": "https://amr-link.open-design.ai/v1"
      },
      "models": {
        "claude-haiku-5.5": {
