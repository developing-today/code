    ".opencode/instructions/subagents.md"
  ],
  "compaction": {
    "reserved": 8192
  },
  "websearch": {
    "provider": "random"
  },
  "warming": true,
  "plugins": [
    // "@pieliesdie/opencode-antigravity-auth@2.0.0", -- disabled 2026-10-24: direct-auth/API-key agy route off; plan agy runs via the antigravity-ls proxy only
    "opencode-working-memory@latest",
    "opencode-scheduler@latest",
    "@openspoon/subtask2@latest",
    "@mohak34/opencode-notifier@latest",
    "opencode-pty@latest",
    "opencode-devcontainers@latest",
    "@franlol/opencode-md-table-formatter@latest",
    "opencode-cmd-provider@latest",
    "opencode-cockpit@latest",
    "opencode-models-discovery@latest",
    "opencode-mem@latest",
    "opencode-auto-continue@https://github.com/developing-today/opencode-auto-continue/archive/refs/tags/latest.tar.gz"
  ],
  "experimental": {
    "provider_routes": {
      // openai-plan (2026-11-01): the ChatGPT pair as ONE provider
      // route - openai.alternate (popesdrew) attempted first on every
      // dispatch, openai.main (drewrypope) the reserve; main serves only
      // when alternate fails or is demoted. Consumed by terra-plan,
      // sol-plan and luna-plan as openai-plan/<model>. Change the
      // account order HERE, in this providers list, and nowhere else.
      // (2026-11-03: the main account got its own instance id,
      // openai.main, so the bare openai provider is now only the
      // instanceOf parent + catalog - no account rides it directly.)
      // 2026-11-03 (Drew, direct order): WEIGHTED 2:1 main:alternate,
      // replacing the ordered alternate-first arrangement above - main
      // (fresh weekly window) carries the pair, alternate backs it.
      "openai-plan": {
        "providers": ["openai.main", "openai.alternate"],
        "selection": "weighted",
        "weights": { "openai.main": 2, "openai.alternate": 1 }
      },
      // mistral-plan (2026-11-04, Drew): the Mistral pair as ONE
      // provider route — vibe-direct attempted first on every dispatch
      // (the Vibe plan leg), the plain Mistral API provider the
      // reserve; the API leg serves only when vibe-direct fails or is
      // demoted. The legs use DIFFERENT keys by design (corrected
      // 2026-11-06): Mistral meters per key — vibe-direct's keyring
      // sign-in key bills the Vibe plan budget; the API leg's enrolled
      // "mistral" integration credential bills the account API budget.
      // Change the leg order HERE, in this providers list, and
      // nowhere else.
      "mistral-plan": {
        "providers": ["vibe-direct", "mistral"],
        "selection": "ordered"
      },
      // opencode-go-plans (2026-11-03, Drew): the OpenCode Go plans as
      // ONE virtual provider (provider routes, opencode#1132). Consumers
      // name opencode-go-plans/<model> in lieu of the per-account
      // providers. Round-robin: the two accounts are peers on the same
      // plan, so they split traffic evenly (an earlier weighted 3/2
      // burn-by-expiry tilt was dropped for the simpler equal split).
      // 2026-11-03 (Drew, direct order): WEIGHTED 2:1
      // drewrypope:popesdrew, replacing the equal round-robin split
      // described above; the opencode providers are weighted above
      // opendesign in every pool that seats both.
      // The bare opencode-go provider is NOT a member: it has no account
      // of its own and rides whichever console login is active, so its
      // burn landed on that account unattributed. Quota/health rules
      // still demote a walled member inside the group.
      "opencode-go-plans": {
        "providers": ["opencode-go.drewrypope", "opencode-go.popesdrew"],
        "selection": "weighted",
        "weights": { "opencode-go.drewrypope": 2, "opencode-go.popesdrew": 1 }
      }
    },
    "model_routes": {
      // Route pools built 2026-10-25. Design: doc/2026-10-25T21-11-31Z_design_route-pools/
      // Per-model pools join every plan provider serving a model; tier pools nest them.
      // Plan routes only. (The DeepSeek PAYG reserve that used to tail the
      // deepseek-flash route was removed 2026-10-27 — see that route.)
      // Design-code personas REMOVED 2026-11-03 (Drew, direct order): the
      // 11 persona routes carried here from the retired design-code door
      // (opencode#1413) are deleted. Drew does not run design personas --
      // the only design provider in this config is "opendesign".

      "deepseek-flash-plan": {
        "name": "DeepSeek Flash 1017 - plan stack + mistral-plan",
        // 2026-10-26: per-leaf variant remaps (honored by expansion since
        // developing-today/opencode#541). ClinePass has no medium/xhigh; OpenDesign tops at
        // high. Remaps keep every leaf in the dispatch at its nearest wired rung.
        // 2026-10-27 (issue #1328 D5): OpenCode Go leaves added. The dotted
        // id deepseek-v4.1-flash was probe-verified through BOTH Go workspace
        // doors (real completions, billing_source "go"; the 2026-10-24
        // invalid id was the dash form deepseek-v4-flash, which survives only
        // as the ClinePass/OpenDesign spelling). Go's Flash caps are the
        // largest on those plans (~$80 promo/workspace) and both workspaces
        // are CANCELLED — Personal ends 2026-11-02 (monthly 80% used), Lab
        // 2026-11-06 (62%) — so weights mirror luna-plan's burn-by-expiry
        // (drewrypope 3 ahead of popesdrew 2; the ClinePass/OpenDesign leaves stay
        // at the default and carry the pool when a Go leaf walls or the Go
        // periods end). Go's Flash natively offers low/high/max, so its
        // remaps match the ClinePass leaf's.
        // 2026-10-27 pool redesign: the base opencode-go leaf joins (Drew's
        // rule: a pool with one Go workspace carries all three — personal,
        // lab, base; the base provider rides the Lab login, so it sits at
        // the default weight behind both named workspaces), and Command
        // Code joins as a minor leaf (weight 0.5; $1 Go tier, $10
        // credits/mo — its boosted Flash allowance is small, the free
        // routes are its durable value; issue #1328 D4).
        // 2026-11-03 (Drew): opendesign/deepseek-v4-flash leaf REMOVED from this pool — the dotted deepseek-v4.1-flash leaf exists in the same opendesign catalog, so the older v4 leaf is dead weight.
        // 2026-11-05 (Drew, direct order): the official-API leg joins —
        // deepseek/deepseek-flash (the model named "1017" in the deepseek
        // provider) is seated as this pool's second serving route beside
        // the plan doors, and selection becomes "weighted" with an
        // aggregate 2:1 plan:API split. The plan leaves keep their tuned
        // proportions (Go 6, ClinePass 1, OpenDesign 1, Command Code 0.5;
        // total 8.5) and the API leaf carries half the plan total (4.25),
        // so the plan doors draw ~2/3 of new sessions and the API door
        // ~1/3 (weighted draws are proportional; sessions stay sticky).
        // The deepseek provider is re-enabled in the switchboard for
        // this seat, keyed by DEEPSEEK_API_KEY (nixos/agent-auth +
        // home/common materializer). Both legs were probe-verified
        // responding before this landed: the API leg by a direct
        // completion on deepseek-flash, the plan legs by the pool's
        // standing live traffic.
        // CORRECTED 2026-11-05 (Drew, later direct orders, same day —
        // supersedes the paragraph directly above): the weighted 2:1
        // split and the provider re-enablement are BOTH reverted. The
        // pool is now a ROUND-ROBIN STACK, in this order: the DeepSeek
        // plan leaves in their standing arrangement (Go plans,
        // ClinePass, OpenDesign, Command Code), then mistral-plan as
        // ONE member (the whole virtual provider nested as a unit —
        // its internal ordered legs, vibe plan first and the Mistral
        // API as its own fallback, are NOT flattened into this pool),
        // then deepseek/deepseek-flash LAST. Under this fork's
        // round-robin (#1122) a member's weight is its priority TIER,
        // not a traffic share: draws rotate evenly inside the top
        // tier whose members are eligible, and a lower tier serves
        // only when every higher tier is ineligible. The weights below
        // are therefore stack positions, not shares: the plan leaves
        // keep their relative order (Go 6 over ClinePass/OpenDesign 1
        // over Command Code 0.5), mistral-plan sits below them at
        // 0.25, and the deepseek slot is last at 0.1. The deepseek
        // provider is DISABLED (see the switchboard): its seat is a
        // slot that contributes no leaf and cannot be drawn while
        // disabled — see the switchboard note for the mechanism and
        // the decision-record proof. Every DeepSeek Flash leaf seated
        // here is the 1017 variant where its provider offers a choice
        // (Go, ClinePass, OpenDesign and Command Code all seat their
        // deepseek-v4.1-flash; the deepseek provider seats the model
        // it names "DeepSeek V4.1 Flash 1017"). The mistral-plan
        // member seats mistral-small-latest, the Flash-class Mistral
        // model both of mistral-plan's legs serve (vibe-direct
        // declares it; the mistral API catalog carries it).
        // REMOVED 2026-11-06 (#6414): the deepseek/deepseek-flash
        // target and its 0.1 weight are gone from this route. The
        // metered-provider guard (bin/check-opencode-metered-providers)
        // rejects a metered selection even while its provider is
        // disabled - its test suite names that stance explicitly -
        // and the slot design above made main's bin-tests CI fail on
        // exactly that one violation. The deepseek provider stays
        // DISABLED in the switchboard and its definition and
        // DEEPSEEK_API_KEY plumbing stay in place; re-enabling is now
        // a deliberate two-step change: delete "deepseek" from
        // disabled_providers AND re-seat "deepseek/deepseek-flash" as
        // this route's last target (weight 0.1) in the same pass that
        // records Drew's approval for the PAYG use.
        "targets": [
          {
            "model": "opencode-go-plans/deepseek-v4.1-flash",
            "variants": { "medium": "high", "xhigh": "max" }
          },
          {
            "model": "cline-pass/deepseek-v4.1-flash",
            "variants": { "medium": "high", "xhigh": "max" }
          },
          {
            "model": "opendesign/deepseek-v4.1-flash",
            "variants": { "xhigh": "high", "max": "high" }
          },
          "commandcode/deepseek/deepseek-v4.1-flash",
          {
            "model": "mistral-plan/mistral-small-latest",
            // Variant remap: the pool's effort rungs map onto the two
            // variants both mistral-plan legs can produce (none /
            // high — see the vibe-direct model note). The remap keys
            // are what let the pool keep offering its rungs with this
            // member seated; the values keep the plan leg in front at
            // every rung (a #low draw runs the group at "none", a
            // #high draw at "high", both producible by vibe-direct
            // first and the API leg alike).
            "variants": { "low": "none", "medium": "high", "high": "high", "xhigh": "high", "max": "high" }
          }
        ],
        "selection": "round-robin",
        "autonomy": "rules",
        // Round-robin tier keys (#1122), NOT traffic shares — see the
        // stack note above. Higher tier serves first; rotation is
        // even within a tier.
        "weights": {
          "opencode-go-plans/deepseek-v4.1-flash": 6,
          "cline-pass/deepseek-v4.1-flash": 1,
          "opendesign/deepseek-v4.1-flash": 1,
          "commandcode/deepseek/deepseek-v4.1-flash": 0.5,
          "mistral-plan/mistral-small-latest": 0.25
        }
      },
      "deepseek-flash": {
        "name": "DeepSeek Flash - plan providers only",
        // 2026-10-27 pool-coverage audit: the PAYG tail (deepseek/deepseek-chat)
        // is REMOVED. The registry's NEVER FUNDS rule (Drew, 2026-10-25) states
        // supervised sessions run on plan quotas only and a funds error is a
        // wall — rotate or stop — and it explicitly supersedes older orderings.
        // This route was the route set's only remaining funds exposure: when
        // every plan Flash leaf walled, workhorse traffic spilled silently to
        // metered DeepSeek billing. Scout and speed already address the plan
        // pool directly for exactly this reason. The route name is kept so
        // workhorse's reference is untouched; if the plan pool is down the
        // target simply yields nothing ready and the wall protocol applies.
        // To restore the old reserve: re-add the deepseek-chat leaf as a
        // second target (one block).
        "targets": ["opencode-route/deepseek-flash-plan"],
        "selection": "ordered",
        "autonomy": "rules"
      },
