  "agent": {
    "build": {
      "mode": "all",
      "permissions": [
        {
          "action": "*",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "external_directory",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "openchamber",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "openchamber_notify",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "openchamber_memory",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "openchamber_web",
          "resource": "*",
          "effect": "allow"
        },
