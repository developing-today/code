  "instructions": [
    ".opencode/instructions/mcpx.md",
    ".opencode/instructions/subagents.md"
  ],
  "compaction": {
    "reserved": 8192
  },
  "websearch": {
    "provider": "random"
  },
  "warming": true,
  "plugin": [
    // "@pieliesdie/opencode-antigravity-auth@2.0.0", -- disabled 2026-10-24: direct-auth/API-key agy route off; plan agy runs via the antigravity-ls proxy only
    "opencode-working-memory@latest",
    "opencode-scheduler@latest",
    "@openspoon/subtask2@latest",
    "@mohak34/opencode-notifier@latest",
    "opencode-pty@latest",
    "opencode-devcontainers@latest",
    "@franlol/opencode-md-table-formatter@latest",
    "opencode-cmd-provider@latest",
    "opencode-cockpit@latest",
    "@openchamber/opencode-claude@1.3.8",
    "opencode-models-discovery@latest",
    "opencode-mem@latest",
    "opencode-auto-continue@https://github.com/developing-today/opencode-auto-continue/archive/refs/tags/latest.tar.gz"
  ],
  "experimental": {
    "model_routes": {
      // Route pools built 2026-10-25. Design: doc/2026-10-25T21-11-31Z_design_route-pools/
      // Per-model pools join every plan provider serving a model; tier pools nest them.
      // Plan routes only. (The DeepSeek PAYG reserve that used to tail the
      // deepseek-flash route was removed 2026-10-27 — see that route.)
      "deepseek-flash-plan": {
        "name": "DeepSeek Flash - plan providers",
        // 2026-10-26: per-leaf variant remaps (honored by expansion since
        // developing-today/opencode#541). ClinePass has no medium/xhigh; OpenDesign tops at
        // high. Remaps keep every leaf in the dispatch at its nearest wired rung.
        // 2026-10-27 (issue #1328 D5): OpenCode Go leaves added. The dotted
        // id deepseek-v4.1-flash was probe-verified through BOTH Go workspace
        // doors (real completions, billing_source "go"; the 2026-10-24
        // invalid id was the dash form deepseek-v4-flash, which survives only
        // as the ClinePass/OpenDesign spelling). Go's Flash caps are the
        // largest on those plans (~$80 promo/workspace) and both workspaces
        // are CANCELLED — Personal ends 2026-11-02 (monthly 80% used), Lab
        // 2026-11-06 (62%) — so weights mirror luna-plan's burn-by-expiry
        // (Personal 3 ahead of Lab 2; the ClinePass/OpenDesign leaves stay
        // at the default and carry the pool when a Go leaf walls or the Go
        // periods end). Go's Flash natively offers low/high/max, so its
        // remaps match the ClinePass leaf's.
        // 2026-10-27 pool redesign: the base opencode-go leaf joins (Drew's
        // rule: a pool with one Go workspace carries all three — personal,
        // lab, base; the base provider rides the Lab login, so it sits at
        // the default weight behind both named workspaces), and Command
        // Code joins as a minor leaf (weight 0.5; $1 Go tier, $10
        // credits/mo — its boosted Flash allowance is small, the free
        // routes are its durable value; issue #1328 D4).
        "targets": [
          {
            "model": "opencode-go.personal/deepseek-v4.1-flash",
            "variants": { "medium": "high", "xhigh": "max" }
          },
          {
            "model": "opencode-go.lab/deepseek-v4.1-flash",
            "variants": { "medium": "high", "xhigh": "max" }
          },
          {
            "model": "opencode-go/deepseek-v4.1-flash",
            "variants": { "medium": "high", "xhigh": "max" }
          },
          {
            "model": "cline-pass/deepseek-v4.1-flash",
            "variants": { "medium": "high", "xhigh": "max" }
          },
          {
            "model": "opendesign/deepseek-v4.1-flash",
            "variants": { "xhigh": "high", "max": "high" }
          },
          {
            "model": "opendesign/deepseek-v4-flash",
            "variants": { "xhigh": "high", "max": "high" }
          },
          "commandcode/deepseek/deepseek-v4.1-flash"
        ],
        "selection": "round-robin",
        "autonomy": "rules",
        "weights": {
          "opencode-go.personal/deepseek-v4.1-flash": 3,
          "opencode-go.lab/deepseek-v4.1-flash": 2,
          "commandcode/deepseek/deepseek-v4.1-flash": 0.5
        }
      },
      "deepseek-flash": {
        "name": "DeepSeek Flash - plan providers only",
        // 2026-10-27 pool-coverage audit: the PAYG tail (deepseek/deepseek-chat)
        // is REMOVED. The registry's NEVER FUNDS rule (Drew, 2026-10-25) states
        // supervised sessions run on plan quotas only and a funds error is a
        // wall — rotate or stop — and it explicitly supersedes older orderings.
        // This route was the route set's only remaining funds exposure: when
        // every plan Flash leaf walled, workhorse traffic spilled silently to
        // metered DeepSeek billing. Scout and speed already address the plan
        // pool directly for exactly this reason. The route name is kept so
        // workhorse's reference is untouched; if the plan pool is down the
        // target simply yields nothing ready and the wall protocol applies.
        // To restore the old reserve: re-add the deepseek-chat leaf as a
        // second target (one block).
        "targets": ["opencode-route/deepseek-flash-plan"],
        "selection": "ordered",
        "autonomy": "rules"
      },
      "deepseek-pro-plan": {
        "name": "DeepSeek V4 Pro - plan providers",
        // 2026-10-27 pool redesign: Go x3 + Command Code (minor) join, per
        // the same all-workspaces rule as deepseek-flash-plan. This pool
        // seats no tier (specialist's Pro relief tail was removed in the
        // same pass — Pro's II band sits below the specialist chain); it
        // remains the named pool for direct calls.
        "targets": [
          {
            "model": "opencode-go.personal/deepseek-v4-pro",
            "variants": { "medium": "high", "xhigh": "max" }
          },
          {
            "model": "opencode-go.lab/deepseek-v4-pro",
            "variants": { "medium": "high", "xhigh": "max" }
          },
          {
            "model": "opencode-go/deepseek-v4-pro",
            "variants": { "medium": "high", "xhigh": "max" }
          },
          {
            "model": "cline-pass/deepseek-v4-pro",
            "variants": { "low": "high", "medium": "high", "xhigh": "max" }
          },
          {
            "model": "opendesign/deepseek-v4-pro",
            "variants": { "xhigh": "high", "max": "high" }
          },
          "commandcode/deepseek/deepseek-v4-pro"
        ],
        "selection": "round-robin",
        "autonomy": "rules",
        "weights": {
          "commandcode/deepseek/deepseek-v4-pro": 0.5
        }
      },
      "haiku-plan": {
        "name": "Claude Haiku - plan providers",
        // 2026-10-27 pool redesign: ORDERED, flat doors first and the
        // metered Go premium leaves last. The Go x3 leaves
        // (claude-haiku-5-5, 1M context) close the chain — Go's Haiku
        // burns the small premium allowance, so it is spent last.
        // 2026-10-28 (Job 2): order is now claude-code → opendesign →
        // Go.personal → Go.lab → Go.base. claude-code leads (dormant
        // while the provider is disabled on the Claude free tier — it
        // rejoins automatically on re-enable, issue #1132); OpenDesign
        // is the pool's live flat door today.
        "targets": [
          "claude-code/claude-haiku-5-5",
          {
            "model": "opendesign/claude-haiku-5.5",
            "variants": { "xhigh": "high", "max": "high" }
          },
          "opencode-go.personal/claude-haiku-5-5",
          "opencode-go.lab/claude-haiku-5-5",
          "opencode-go/claude-haiku-5-5"
        ],
        "selection": "ordered",
        "autonomy": "rules"
      },
      // openai-plan (2026-10-31, Drew): the GPT account burn order,
      // defined ONCE, here. The ChatGPT pair - openai.alternate
      // (popesdrew) first, openai (drewrypope) the reserve - is an
      // ORDERED pair: alternate is attempted first on every dispatch
      // and main serves only when alternate fails or is demoted.
      // Grammar note: route leaves are concrete provider/model refs
      // and expand() passes no model context into a nested route, so
      // one model-agnostic route cannot serve Terra, Sol and Luna;
      // the construct is therefore instantiated per model as
      // openai-plan-<model>, and every pool that seats the pair
      // (terra-plan, sol-plan, luna-plan) consumes its model's
      // instance instead of naming the doors itself. Change the
      // account order HERE, in these three sibling definitions, and
      // nowhere else. Supersedes the per-pool pair orderings and
      // weights landed earlier today in b53ba7951. (A fork-side
      // tiered round-robin is planned; for a two-account pair,
      // ordered and tiered are behaviorally identical, so these
      // definitions stand as-is when it lands.)
      "openai-plan-terra": {
        "name": "OpenAI plan - Terra account pair (ordered)",
        "targets": [
          "openai.alternate/gpt-6.1-terra",
          "openai/gpt-6.1-terra"
        ],
        "selection": "ordered",
        "autonomy": "rules"
      },
      "openai-plan-sol": {
        "name": "OpenAI plan - Sol account pair (ordered)",
        "targets": [
          "openai.alternate/gpt-6.1-sol",
          "openai/gpt-6.1-sol"
        ],
        "selection": "ordered",
        "autonomy": "rules"
      },
      "openai-plan-luna": {
        "name": "OpenAI plan - Luna account pair (ordered)",
        "targets": [
          "openai.alternate/gpt-6-luna",
          "openai/gpt-6-luna"
        ],
        "selection": "ordered",
        "autonomy": "rules"
      },
      "luna-plan": {
        "name": "GPT Luna - plan providers",
        // 2026-10-27 pool-coverage audit: burn-by-expiry weights. Both
        // OpenCode Go workspaces are CANCELLED and their paid periods end
        // inside two weeks (Personal 2026-11-02, monthly 80% used; Lab
        // 2026-11-06, 62% used) — unspent Go quota evaporates, with no
        // rollover and no renewal. Equal round-robin gave each Go leaf the
        // same share as the non-expiring ChatGPT doors, stranding that
        // quota. Weights now burn Go first (Personal ahead of Lab: sooner
        // deadline), the ChatGPT doors stay at the default as the OpenAI
        // reserve, and OpenDesign's small short-window plan keeps the
        // default too. When a Go leaf walls, quota demotion + the remaining
        // leaves carry the pool as before.
        // 2026-10-27 pool redesign: the base opencode-go leaf joins at the
        // default weight (all-three-workspaces rule; it rides the Lab
        // login, so it burns last among the Go leaves).
        // 2026-10-28 (Job 2): the Go leaves move from gpt-5.6-luna to
        // gpt-6-luna. Step-0 verdict: models.dev's opencode-go catalog
        // and the live serve catalog both list BOTH ids on all three
        // workspaces; gpt-6-luna (2026-09-22) is the current Luna on
        // every other door in this pool (openai, openai.alternate,
        // opendesign) at half of 5.6's reference rates, so the pool
        // now serves one Luna generation on every door.
        // 2026-10-31 (Drew): the ChatGPT pair seats through
        // opencode-route/openai-plan-luna (ordered: alternate first,
        // main the reserve) at the pair's previous combined weight
        // (1.5 + 1 = 2.5). The Go burn-by-expiry weights (3/2) above
        // are untouched.
        "targets": [
          "opencode-route/openai-plan-luna",
          {
            "model": "opendesign/gpt-6-luna",
            "variants": { "xhigh": "high", "max": "high" }
          },
          "opencode-go.lab/gpt-6-luna",
          "opencode-go.personal/gpt-6-luna",
          "opencode-go/gpt-6-luna"
        ],
        "selection": "round-robin",
        "autonomy": "rules",
        "weights": {
          "opencode-go.personal/gpt-6-luna": 3,
          "opencode-go.lab/gpt-6-luna": 2,
          "opencode-route/openai-plan-luna": 2.5
        }
      },
      // glm-flash-plan DISSOLVED 2026-10-27 (pool redesign): GLM 5.3 Flash
      // is seated nowhere. Decline-with-reason: it is dominated on its own
      // doors — the slowest decode in the fleet (57-61 t/s; AA v5: II 32,
      // level with DeepSeek Flash's) at a higher burn than MiMo, on the
      // same shared plan meters. The provider blocks
      // keep listing the GLM models (catalog rule); no route seats them.
      "gemini-flash-plan": {
        "name": "Gemini Flash - plan providers",
        // 2026-10-30 (route audit): this pool is single-door on
        // antigravity-ls, and that fragility is real — when the ls
        // proxy was down (2026-10-24/25) every Gemini Flash call
        // failed with ConnectionRefused (38 failures in
        // route_attempt) with nothing to fail over to. The obvious
        // second door, antigravity-agy, is deliberately NOT seated
        // here: bin/agy-proxy.mjs is text-only (it builds its prompt
        // from body.messages, ignores body.tools, and never returns
        // structured tool calls — Codex P1 on the audit PR, verified
        // against the proxy source), so an agy leaf would silently
        // end tool-using turns with a text "success" and block
        // failover. Seat agy here only once the proxy bridges tool
        // calls; until then ls is the only tool-capable Gemini Flash
        // door and this pool rides on its proxy being up.
        // 2026-10-30 (Drew): the seat moved to antigravity-direct. The
        // direct door bridges tool calls (verified live, including the
        // Gemini 3 thought_signature round-trip the objection above was
        // about), the ls proxy service is retired, and this pool now
        // rides on the direct door the same way.
        "targets": [
          {
            "model": "antigravity-direct/gemini-3.8-flash",
            "variants": { "xhigh": "high", "max": "high" }
          }
        ],
        "selection": "round-robin",
        "autonomy": "rules"
      },
      "sonnet-plan": {
        "name": "Claude Sonnet - plan providers",
        // 2026-10-28 (Job 2): claude-code joins — its provider block
        // now lists claude-sonnet-5-5 (the proxy catalog gained the
        // model in #1324; the block extension lands in this PR). The
        // leaf is dormant while claude-code is disabled and rejoins
        // automatically on re-enable.
        // 2026-10-30 (route audit): with claude-code dormant this
        // pool is single-live-door on antigravity-ls. antigravity-agy
        // is deliberately NOT seated as the second door: its proxy
        // is text-only (no tool-call bridging — see the note in
        // gemini-flash-plan). The pool's resilience is the ls proxy
        // plus claude-code's return.
        // 2026-10-30 (Drew): the seat moved to antigravity-direct —
        // "only the direct, replace all others". The direct door
        // serves claude-sonnet-5-5 and bridges tool calls; the pool
        // is single-live-door on the direct door, plus claude-code's
        // return.
        "targets": [
          "claude-code/claude-sonnet-5-5",
          {
            "model": "antigravity-direct/claude-sonnet-5-5",
            "variants": { "xhigh": "high", "max": "high" }
          }
        ],
        "selection": "round-robin",
        "autonomy": "rules"
      },
      "opus-plan": {
        "name": "Claude Opus - plan providers",
