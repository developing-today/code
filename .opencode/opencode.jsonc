  "agent": {
    "build": {
      "mode": "all"
    },
    "compaction": {
      "threshold": 0.5
    },
    "coder": {
      "model": "cloudflare-gateway/@cf/deepseek-ai/deepseek-v4-flash-0731",
      "temperature": 0.2
    },
    "reasoner": {
      "model": "cloudflare-gateway/@cf/deepseek-ai/deepseek-v4-pro-0813",
      "temperature": 0
    },
    "classifier": {
      "model": "cloudflare-gateway/@cf/cloudflare/clef-flash",
      "temperature": 0,
      "maxTokens": 256
    },
    "classifier-complex": {
      "model": "cloudflare-gateway/@cf/cloudflare/clef",
      "temperature": 0,
      "maxTokens": 512
    }
  },
  "instructions": [
    ".opencode/instructions/mcpx.md",
    ".opencode/instructions/subagents.md"
  ],
  "compaction": {
    "reserved": 8192
  },
  "websearch": {
    "provider": "random"
  },
  "warming": true,
  "plugin": [
    ["./.opencode/plugin/mcpx-session.ts", { "tools": true, "instructions": true, "daemonTools": true }],
    "opencode-working-memory@latest",
    "opencode-scheduler@latest",
    "@openspoon/subtask2@latest",
    "@mohak34/opencode-notifier@latest",
    "opencode-pty@latest",
    "opencode-devcontainers@latest",
    "@franlol/opencode-md-table-formatter@latest",
    "opencode-cmd-provider@latest",
    "opencode-cockpit@latest",
    "@openchamber/opencode-claude@1.3.8",
    "opencode-models-discovery@latest",
    "@pieliesdie/opencode-antigravity-auth@2.0.0",
    "opencode-mem@latest",
    "opencode-auto-continue@https://github.com/developing-today/opencode-auto-continue/archive/refs/tags/latest.tar.gz"
  ],
  "experimental": {
    "model_routes": {
      "cheap-pool": {
        "targets": [
          "google/gemma-4-31b-it",
          "google/gemma-4-26b-a4b-it",
          "google/lyria-3-pro-preview",
          "google/lyria-3-clip-preview"
        ],
        "autonomy": "rules",
        "selection": "ordered"
      }
    }
  }
