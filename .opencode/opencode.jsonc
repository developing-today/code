        // the same effort on the same doors and the same quota — illusory
        // diversity (if Sol walls on quota, Terra walls too). DeepSeek Pro
        // tail REMOVED: its <=36 ceiling is below this tier's band.
        "targets": [
          "opencode-route/sonnet-plan#high",
          "opencode-route/argon-plan#high",
          "opencode-route/spark-plan#max",
          "opencode-route/sol-plan#medium"
        ],
        "selection": "ordered",
        "autonomy": "rules"
      },
      "summit": {
        "name": "Summit - very complex design only, deliberate use",
        // 2026-10-30: the Wonder leaf ran through muse-proxy
        // (provider "muse", muse/muse-wonder-1.0#max) — the direct
        // meta door is dead (attestation; see the "muse" provider
        // note).
        // 2026-10-30 (amendment, Drew): the leaf now seats
        // muse-direct/muse-wonder-1.0-contributor#xhigh (Responses
        // direct mode replaced both older Meta doors; the #max
        // variant is preserved). Same position in the ordered chain.
        // 2026-10-26: Sol addressed through sol-plan (four doors) instead of a single direct
        // OpenAI leaf; Wonder runs the contributor model (always cheaper on the Meta plan).
        // 2026-10-27 pool redesign: Argon #high inserts at #2 and Sol
        // #xhigh moves LAST. The OpenAI plan is the fleet's deepest
        // reserve, so the chain spends Antigravity (Opus), the Go
        // contributor bucket (Argon — CAI 64, the strongest coding
        // evidence here), and Meta (Wonder) before it touches OpenAI at
        // all; the previous order burned Sol ahead of Wonder, backwards
        // under the reserve rule.
        "targets": [
          "opencode-route/opus-plan#high",
          "opencode-route/argon-plan#high",
          "muse-direct/muse-wonder-1.0-contributor#xhigh",
          "opencode-route/sol-plan#xhigh"
        ],
        "selection": "ordered",
        "autonomy": "rules"
      },
      "speed": {
        "name": "Speed - fastest seats at or above the Haiku bar, for latency-bound work",
        // 2026-10-26 pass 3 (AA figures re-baselined to v5 2026-10-31, #1673): a latency pool is judged on
        // time-to-first-token as much as decode — Spark contributor #xhigh / TTFT 19.1s /
        // 303 t/s, Flash #max II 32 / 1.1s / 170 t/s (plan pool addressed directly, no PAYG
        // tail), Haiku #medium / 11.9s / 174 t/s (the pool's minimum-bar seat, kept for
        // its speed; #xhigh's 67.4s TTFT failed the pool's purpose). Luna REMOVED: its #max
        // paired the pool's slowest decode (~127 t/s) with a 93.8s TTFT.
        // 2026-10-27 pool redesign: one definition of fast — decode
        // throughput at a sensible rung, II floor ~38. Flash drops from
        // #max to #high (max is fast per token but slow per task: the
        // extra output tokens stretch wall-clock), and Haiku rises from
        // #medium (II 34, scout-grade) to #high (II 38 at the same
        // ~190 t/s decode; its 26.7s TTFT is the accepted cost). Beam is
        // faster still (385 t/s) but II 30 is below this pool's floor —
        // it is scout's speed, not this tier's.
        // 2026-10-28 (Job 2): the Spark seat repoints to spark-plan at
        // the same rung and weight, and Gemini Flash joins at weight 1
        // via gemini-flash-plan — antigravity-ls serves
        // gemini-3.8-flash live (AA v5: II 31 at high,
        // ~311 t/s decode), which clears this pool's bar.
        "targets": [
          "opencode-route/spark-plan#xhigh",
          "opencode-route/deepseek-flash-plan#high",
          "opencode-route/haiku-plan#high",
          "opencode-route/gemini-flash-plan#high"
        ],
        "selection": "round-robin",
        "autonomy": "rules",
        "weights": {
          "opencode-route/spark-plan": 3,
          "opencode-route/deepseek-flash-plan": 2,
          "opencode-route/haiku-plan": 2,
          "opencode-route/gemini-flash-plan": 1
        }
      },
      "small-100k": {
        "name": "Small 100k - Haiku + Luna below the 100k context cliff",
        // 2026-10-26 (as luna-haiku-100k): both members price much cheaper below 100k
        // context. The route's context cap (developing-today/opencode#554) presents a
        // 100k limit, so sessions pinned here compact before crossing the cliff. On fork
        // builds predating #554 the decoder strips the unknown limit key and the pool
        // simply runs uncapped.
        // AA v5: Haiku #high II 30, Luna #xhigh II 23 (TTFT 24.2s; #max would be 93.8s).
        // 2026-10-27 pool redesign: this is now the <=100k element of the
        // renamed `small` pool (below).
        "targets": [
          "opencode-route/haiku-plan#high",
          "opencode-route/luna-plan#xhigh"
        ],
        "selection": "round-robin",
        "autonomy": "rules",
        "limit": { "context": 100000 }
      },
      "small": {
        "name": "Small - light work in small contexts, Haiku + Luna value seats",
        // RENAMED 2026-10-27 (pool redesign) from luna-haiku-100k. Sessions
        // pinned to the old id need re-pinning. The pool is the fleet's
        // light/small tier: Haiku and Luna are much cheaper in small
        // contexts, so membership is organized by context ceiling —
        //   - the <=100k element (small-100k): Haiku #high + Luna #xhigh
        //   - the <=200k element: Haiku #high alone (Luna's cheap tier
        //     ends at 100k)
        // The route schema has no per-target context limit, so the
        // elements are expressed as a nested route (small-100k, capped at
        // 100k) beside the direct Haiku target, under this route's 200k
        // cap. Haiku 5.5 is 1M native — the 200k element is a cost-policy
        // ceiling, not a model limit: bigger jobs belong to bigger pools.
        "targets": [
          "opencode-route/small-100k",
          "opencode-route/haiku-plan#high"
        ],
        "selection": "round-robin",
        "autonomy": "rules",
        "limit": { "context": 200000 }
      }
    },
    "model_route_windows": {
      // Named route windows (fork PR #649, opencode#639). DeepSeek
      // peak: Mon-Fri 01:00-04:00 and 06:00-10:00 UTC — deductions
      // double on Go in these windows and ClinePass's DeepSeek
      // reference rates split the same way. The shipped Window
      // schema holds one daily range per named window, so the two
      // ranges are two windows; the background route composes them
      // (see its comment for the position-by-position reading).
      // VERIFIED 2026-10-29 against DeepSeek's own pricing page
      // (https://api-docs.deepseek.com/quick_start/pricing/): "Off-peak
      // rates are half of the peak rates. Peak hours are 01:00 - 04:00
      // and 06:00 - 10:00 UTC, Monday through Friday, excluding Chinese
      // public holidays. All other hours are off-peak, including
      // weekends and Chinese public holidays in full." So the times
      // and the weekend treatment below are exactly right (weekends
      // are off-peak in full — Chinese make-up workdays on a weekend
      // do NOT become peak), but one clause is NOT encoded: a Chinese
      // public holiday that falls Mon-Fri is off-peak for the whole
      // day, and these windows still treat it as peak. The Window
      // schema has no calendar dates, date ranges, or holiday lists
      // and a gate cannot exclude one window from another, so the
      // holiday exclusion cannot be expressed today — tracked in
      // developing-today/opencode#821 (date-aware windows). Until
      // that lands these two windows are the closest correct
      // approximation: on weekday Chinese public holidays the
      // background route leads with MiMo and treats Flash as
      // peak-priced when it is actually off-peak — lost value on
      // those days, never overspend.
      "deepseek-peak-early": {
        "daysOfWeek": ["mon", "tue", "wed", "thu", "fri"],
        "start": "01:00",
        "end": "04:00",
        "timezone": "UTC"
      },
      "deepseek-peak-late": {
        "daysOfWeek": ["mon", "tue", "wed", "thu", "fri"],
        "start": "06:00",
        "end": "10:00",
        "timezone": "UTC"
      }
    }
  }
}