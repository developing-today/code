      "background": {
        "name": "Background - patient queue work: best value first, no latency contract",
        // NEW 2026-10-27 (pool redesign): the tier for machinery-dispatched
        // work no human watches — repo sweeps, issue-queue workers,
        // stewardship cycles, batch classification. Ordered chain in value
        // order: DeepSeek Flash at #high first (workhorse-grade when it is
        // available), then the MiMo pool (the fleet's cheapest burn) for
        // the bulk.
        // 2026-10-28: the clock-gated chain designed under
        // opencode#639 is LIVE (named windows landed in fork PR #649;
        // gates are the target `window` field — a window name, or
        // { name, invert: true } for the inverse). DeepSeek deductions
        // double in the peak windows — Mon-Fri 01:00-04:00 +
        // 06:00-10:00 UTC — on Go, and ClinePass's DeepSeek reference
        // rates split the same way (verified against DeepSeek's own
        // pricing page 2026-10-29; the one clause not encoded is the
        // Chinese-public-holiday exclusion — see the
        // model_route_windows comment below and opencode#821), so
        // during peak this chain leads
        // with MiMo and keeps Flash as the fallback, and off-peak it
        // leads with Flash. The shipped Window schema holds ONE
        // daily range per named window, so the two peak ranges are
        // two named windows (deepseek-peak-early / deepseek-peak-late
        // in experimental.model_route_windows below) and the chain
        // composes them into exactly three effective stages:
        //   1. deepseek-flash-plan#high, all doors, OFF-PEAK
        //   2. mimo-flash-plan
        //   3. deepseek-flash-plan#high, all doors, PEAK
        // Positions: the two MiMo positions gated ON each peak
        // window lead during their window; the Flash position gated
        // on the INVERSE of deepseek-peak-early leads in every other
        // regime (all off-peak hours, and as the late-peak fallback
        // behind the late MiMo position); the Flash position gated
        // ON deepseek-peak-early is the early-peak fallback; the
        // final ungated MiMo position is the off-peak failover.
        // No agent defaults here yet — queue workers are repointed as the
        // follow-up step so the adoption is observable.
        "targets": [
          {
            "model": "opencode-route/mimo-flash-plan",
            "window": "deepseek-peak-early"
          },
          {
            "model": "opencode-route/mimo-flash-plan",
            "window": "deepseek-peak-late"
          },
          {
            "model": "opencode-route/deepseek-flash-plan#high",
            "window": { "name": "deepseek-peak-early", "invert": true }
          },
          {
            "model": "opencode-route/deepseek-flash-plan#high",
            "window": "deepseek-peak-early"
          },
          "opencode-route/mimo-flash-plan"
        ],
        "selection": "ordered",
        "autonomy": "rules"
      },
