# Runtime state and local backups under .opencode/ (#367)
# These are per-machine, regenerated by the tooling that uses them,
# and must never be committed: a tracked PID is stale on arrival and
# a tracked SQLite index churns on every run.
*.pid
/artifact-index/
*.bak
*.bak.*
/themes.bak/
/backup/
.gitignore
antigravity-accounts.json
antigravity-accounts.json.*.tmp
antigravity-signature-cache.json
antigravity-logs/
