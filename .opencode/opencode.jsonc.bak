{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": true,
  "plugin": [
    // "@tarquinen/opencode-dcp@latest", // causes large GitHub API request counts — use manual /compact instead
    // "opencode-working-memory@latest",
    // "octto@latest",
    // "micode@latest", // forces context7 MCP server with no opt-out
    // "opencode-scheduler@latest",
    // "@openspoon/subtask2@latest",
    // "@tmegit/opencode-worktree-session@latest",
    "@mohak34/opencode-notifier@latest",
    "@plannotator/opencode@latest",
    "opencode-pty@latest",
    // "opencode-devcontainers@latest",
    // "opencode-pilot@latest",
    "@franlol/opencode-md-table-formatter@latest",
    // "true-mem@latest",
    // "@knikolov/opencode-plugin-simple-memory@latest",
    // "opencode-mem@latest",
    "opencode-auto-continue@https://github.com/developing-today/opencode-auto-continue/archive/refs/tags/latest.tar.gz",
  ],
  "enabled_providers": ["github-copilot", "opencode"],
  "default_agent": "build",
  "model": "github-copilot/gpt-5.6-sol",
  "small_model": "github-copilot/gpt-5.6-terra",
  "provider": {
    "github-copilot": {
      // Keep current-generation GPT and Claude models; hide older and unrelated families.
      "blacklist": [
        "gpt-4.1",
        "gpt-5-mini",
        "gpt-5.2",
        "gpt-5.2-codex",
        "gpt-5.3-codex",
        "gpt-5.4",
        "gpt-5.4-mini",
        "gpt-5.4-nano",
        "gpt-5.5",
        "claude-haiku-4.5",
        "claude-opus-4.5",
        "claude-opus-4.6",
        "claude-opus-4.6-fast",
        "claude-opus-4.7",
        "claude-opus-4.7-fast",
        "claude-opus-4.8",
        "claude-opus-4.8-fast",
        "claude-sonnet-4",
        "claude-sonnet-4.5",
        "claude-sonnet-4.6",
        "gemini-2.5-pro",
        "gemini-3-flash-preview",
        "gemini-3.1-pro-preview",
        "gemini-3.5-flash",
        "kimi-k2.7-code",
        "mai-code-1-flash-picker",
      ],
      "models": {
        "claude-opus-5": {},
      },
    },
  },
  "agent": {
    "build": {
      "mode": "all",
    },
    "plan": {
      "model": "github-copilot/claude-fable-5",
      "variant": "high",
    },
    "general": {
      "model": "github-copilot/gpt-5.6-sol",
      "variant": "medium",
    },
    "explore": {
      "model": "github-copilot/gpt-5.6-sol",
      "variant": "medium",
    },
    "compaction": {
      "model": "github-copilot/gpt-5.6-sol",
    },
    "luna-medium": {
      "description": "Fast, low-cost worker for bounded utility tasks, extraction, formatting, and simple transformations.",
      "mode": "subagent",
      "model": "github-copilot/gpt-5.6-luna",
      "variant": "medium",
    },
    "sol-low": {
      "description": "Low-effort Sol subagent for quick, straightforward coding and research tasks.",
      "mode": "subagent",
      "model": "github-copilot/gpt-5.6-sol",
      "variant": "low",
      "disable": true,
    },
    "sol-medium": {
      "description": "Efficient strong coding worker for general implementation and debugging with low latency.",
      "mode": "subagent",
      "model": "github-copilot/gpt-5.6-sol",
      "variant": "medium",
    },
    "sol-high": {
      "description": "Strong interactive coding worker for difficult debugging and multi-step implementation.",
      "mode": "primary",
      "model": "github-copilot/gpt-5.6-sol",
      "variant": "high",
    },
    "sol-xhigh": {
      "description": "Advanced reasoning agent for hard agentic tasks.",
      "mode": "primary",
      "model": "github-copilot/gpt-5.6-sol",
      "variant": "xhigh",
    },
    "sol-max": {
      "description": "Maximum-effort Sol agent for frontier tasks where quality matters more than latency.",
      "mode": "primary",
      "model": "github-copilot/gpt-5.6-sol",
      "variant": "max",
    },
    "fable-low": {
      "description": "Fast primary agent for difficult repository bugs and diagnosis.",
      "mode": "primary",
      "model": "github-copilot/claude-fable-5",
      "variant": "low",
    },
    "fable-medium": {
      "description": "Primary coding agent for hard multi-file engineering with balanced cost and depth.",
      "mode": "primary",
      "model": "github-copilot/claude-fable-5",
      "variant": "medium",
    },
    "fable-high": {
      "description": "Quality-first agent for architecture, migrations, difficult patches, and deep review.",
      "mode": "primary",
      "model": "github-copilot/claude-fable-5",
      "variant": "high",
    },
    "fable-xhigh": {
      "description": "Advanced reasoning Fable agent for architecture, migrations, and deep review.",
      "mode": "primary",
      "model": "github-copilot/claude-fable-5",
      "variant": "xhigh",
    },
    "fable-max": {
      "description": "Maximum-effort Fable agent for demanding architecture and implementation tasks.",
      "mode": "primary",
      "model": "github-copilot/claude-fable-5",
      "variant": "max",
    },
    "opus-5-med": {
      "description": "Opus 5 primary agent for complex implementation, debugging, and research.",
      "mode": "primary",
      "model": "github-copilot/claude-opus-5",
      "variant": "medium",
    },
    "opus-5-high": {
      "description": "Opus 5 agent for high-effort implementation, architecture, and deep review.",
      "mode": "primary",
      "model": "github-copilot/claude-opus-5",
      "variant": "high",
    },
    "title": {
      "model": "github-copilot/gpt-5.6-luna",
    },
  },
  "instructions": [
    ".opencode/instructions/lootbox.md",
    ".opencode/instructions/subagents.md",
  ],
  "compaction": {
    "reserved": 8192,
  },
}
